    private async Task ShowResonant()
    {
        var clusters = await Api.GetResonantClustersAsync();
        _resL = clusters?.PointsLeft?.Length ?? 0;
        _resR = clusters?.PointsRight?.Length ?? 0;
    }

    private async Task ShowThoughts()
    {
        var thoughts = await Api.GetThoughtClustersAsync();
        _thL = thoughts?.Left?.Length ?? 0;
        _thR = thoughts?.Right?.Length ?? 0;

        ThoughtClusterDto? best = null;

        if (thoughts?.Left is not null)
            for (int i = 0; i < thoughts.Left.Length; i++)
                best = (best is null || thoughts.Left[i].Coherence01 > best.Coherence01) ? thoughts.Left[i] : best;

        if (thoughts?.Right is not null)
            for (int i = 0; i < thoughts.Right.Length; i++)
                best = (best is null || thoughts.Right[i].Coherence01 > best.Coherence01) ? thoughts.Right[i] : best;

        if (best is null)
            _topThought = "(none)";
        else
            _topThought = $"#{best.Id} size={best.Size} coh={best.Coherence01:0.00} @({best.Centroid.X:0},{best.Centroid.Y:0},{best.Centroid.Z:0})";
    }

    private async Task FetchTelemetry()
    {
        try
        {
            _telemetry = await Api.GetTelemetryAsync();

            // PERF: avoid LINQ in UI rendering by preparing a sorted array once per fetch.
            if (_telemetry?.Regions is not null)
            {
                var src = _telemetry.Regions;
                var arr = new RegionTelemetryDto[src.Length];
                Array.Copy(src, arr, src.Length);
                Array.Sort(arr, (a, b) => b.MeanFiringRate.CompareTo(a.MeanFiringRate));
                _regionsByRate = arr;
            }
            else
            {
                _regionsByRate = Array.Empty<RegionTelemetryDto>();
            }
        }
        catch (Exception ex)
        {
            _topThought = $"Telemetry error: {ex.Message}";
        }
    }

