<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>NeuralResonanceEngine.DNNE.Tests</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OliveCostMode Condition="'$(OliveCostMode)' == ''">control</OliveCostMode>
    <DefineConstants Condition="'$(OliveCostMode)' == 'host'">$(DefineConstants);PROFILE_HOST</DefineConstants>
    <DefineConstants Condition="'$(OliveCostMode)' == 'device'">$(DefineConstants);PROFILE_HOST;PROFILE_DEVICE</DefineConstants>
  </PropertyGroup>
  <Target Name="ValidateCostMode" BeforeTargets="CoreCompile">
    <Error Condition="'$(OliveCostMode)' != 'control' and '$(OliveCostMode)' != 'host' and '$(OliveCostMode)' != 'device'" Text="Unknown OliveCostMode." />
  </Target>
  <ItemGroup>
    <ProjectReference Include="../../Structures/NeuralResonanceEngine.Structures.Runtime.csproj" />
    <Compile Include="../CudaInteropProbe/CudaDriverProbe.cs" Link="CudaDriverProbe.cs" />
    <Compile Include="../OliveBatchProbe/OlivaryBatchKernel.cs" Link="OlivaryBatchKernel.cs" />
    <Compile Include="../OliveBatchProbe/OlivaryCpuBatch.cs" Link="OlivaryCpuBatch.cs" />
    <Compile Include="../OliveCudaProbe/OlivaryCudaBatch.cs" Link="OlivaryCudaBatch.cs" />
    <Compile Include="../OliveCudaProbe/CudaDriverProbe.Olive.cs" Link="CudaDriverProbe.Olive.cs" />
    <Compile Include="../OliveCudaProbe/BatchControls.cs" Link="BatchControls.cs" />
    <Compile Include="../OliveCudaTimingProbe/CudaDriverProbe.Memory.cs" Link="CudaDriverProbe.Memory.cs" />
  </ItemGroup>
</Project>
