                                          PreviewMouseLeftButtonUp="BrainViewport_OnMouseLeftButtonUp"
                                          PreviewMouseMove="BrainViewport_OnMouseMove"
                                          MouseLeave="BrainViewport_OnMouseLeave"
                                          LostMouseCapture="BrainViewport_OnLostMouseCapture"
                                          PreviewMouseWheel="BrainViewport_OnMouseWheel">
