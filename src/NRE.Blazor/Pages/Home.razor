@using System.Collections.Generic
@using System.IO
@using Microsoft.AspNetCore.Components.Forms
@using NRE.Contracts.Voice
@using NRE.Blazor.Shared.OperatorConsole
@using NRE.Blazor.Shared.OperatorConsole.Tabs
@page "/"
@implements IDisposable
@inject EngineApiClient Api
@inject RendererInteropService Renderer
@inject ConsoleRefreshCoordinator RefreshCoordinator

<div class="shell">
    <aside class="sidebar">
        <div class="sidebar-header">
            <h3>Neural Resonance Engine</h3>
            <div class="subtitle">v10 · Biological Subsystem Integration</div>
        </div>

        <div class="sidebar-scroll">

        <StatusSummaryPanel
            Step="@_step"
            IsRunning="@_running"
            WallTimeText="@FormatTime(_wallClockUptime)"
            SimTimeText="@FormatTime(_step / 60f)"
            AvgStepMs="@_avgStepMs"
            SimRatio="@_simRatio"
            SleepPhase="@_sleepPhase"
            SleepClass="@GetSleepClass()"
            ThalamicPulse="@_thalamicPulse"
            TotalNeurons="@_totalNeurons"
            TotalSynapses="@_totalSynapses"
            CallosalTraffic="@_callosalTraffic"
            EpisodeCount="@_episodeCount" />

        <ControlToolbar
            IsRunning="@_running"
            IsDark="@_dark"
            DisabledAttributes="@AttrDisabled"
            OnStart="@Start"
            OnStop="@Stop"
            OnSave="@SaveBrain"
            OnLoad="@LoadBrainClick"
            OnToggleDark="@ToggleDark"
            OnToggleAvatar="@ToggleAvatar"
            OnBrainFileSelected="@OnBrainFileSelected" />
        @if (!string.IsNullOrEmpty(_saveLoadStatus))
        {
            <div class="small" style="margin:-4px 0 4px;">@_saveLoadStatus</div>
        }

            <SidebarTabBar SelectedTab="@Tab" OnSelectedTabChanged="@(tab => Tab = tab)" />

            @if (Tab==ConsoleTabs.Stimulus)
            {
                <StimulusTabPanel
                    WebcamRunning="@_webcamRunning"
                    MicRunning="@_micRunning"
                    InternetStreamRunning="@_internetStreamRunning"
                    InternetStreamUrl="@_internetStreamUrl"
                    InternetStreamUrlChanged="@(v => _internetStreamUrl = v)"
                    VisualIntensity="@VisualIntensity"
                    VisualIntensityChanged="@(v => VisualIntensity = v)"
                    VisualSpeedHz="@VisualSpeedHz"
                    VisualSpeedHzChanged="@(v => VisualSpeedHz = v)"
                    VisualSpatialFreq="@VisualSpatialFreq"
                    VisualSpatialFreqChanged="@(v => VisualSpatialFreq = v)"
                    AudioIntensity="@AudioIntensity"
                    AudioIntensityChanged="@(v => AudioIntensity = v)"
                    AudioToneHz="@AudioToneHz"
                    AudioToneHzChanged="@(v => AudioToneHz = v)"
                    DisabledAttributes="@AttrDisabled"
                    OnInjectLeft="@InjectLeft"
                    OnInjectRight="@InjectRight"
                    OnInjectBoth="@InjectBoth"
                    OnStartWebcam="@StartWebcam"
                    OnStopWebcam="@StopWebcam"
                    OnStartMic="@StartMic"
                    OnStopMic="@StopMic"
                    OnStartInternetStream="@StartInternetStream"
                    OnStopInternetStream="@StopInternetStream"
                    OnApplyVisual="@ApplyVisual"
                    OnApplyAudio="@ApplyAudio" />
            }
            else if (Tab==ConsoleTabs.Modulators)
            {
                <ModulatorsTabPanel
                    Dopamine="@_dopamine"
                    DopamineChanged="@(v => _dopamine = (float)v)"
                    Serotonin="@_serotonin"
                    SerotoninChanged="@(v => _serotonin = (float)v)"
                    Noradrenaline="@_norad"
                    NoradrenalineChanged="@(v => _norad = (float)v)"
                    OnApply="@ApplyNeuromods" />
            }
            else if (Tab==ConsoleTabs.Pons)
            {
                <PonsTabPanel
                    PonsArousal="@_ponsArousal"
                    PonsArousalChanged="@(v => _ponsArousal = (float)v)"
                    PonsStability="@_ponsStability"
                    PonsStabilityChanged="@(v => _ponsStability = (float)v)"
                    PonsReset="@_ponsReset"
                    PonsResetChanged="@(v => _ponsReset = (float)v)"
                    PonsThetaHz="@_ponsThetaHz"
                    PonsThetaHzChanged="@(v => _ponsThetaHz = (float)v)"
                    OnApply="@ApplyPons" />
            }
            else if (Tab==ConsoleTabs.Scenes)
            {
                <ScenesTabPanel
                    OnSceneStartle="@SceneStartle"
                    OnSceneHabituation="@SceneHabituation"
                    OnSceneFocusedAttention="@SceneFocusedAttention"
                    OnSceneExploratoryDrive="@SceneExploratoryDrive"
                    OnSceneAnxious="@SceneAnxious"
                    OnSceneSleepCycle="@SceneSleepCycle"
                    OnSceneLucidDream="@SceneLucidDream"
                    OnSceneRewardLearning="@SceneRewardLearning"
                    OnSceneCallosalRace="@SceneCallosalRace"
                    OnSceneReset="@SceneReset" />
            }
            else if (Tab==ConsoleTabs.Systems)
            {
                <SystemsTabPanel
                    ThalamicPulse="@_thalamicPulse"
                    ThalamicFreq="@_thalamicFreq"
                    ThalamicFreqTarget="@_thalamicFreqTarget"
                    ThalamicFreqTargetChanged="@(v => _thalamicFreqTarget = v)"
                    SleepPhase="@_sleepPhase"
                    SleepClass="@GetSleepClass()"
                    SleepPressure="@_sleepPressure"
                    ConsolidationCycles="@_consolidationCycles"
                    EpisodeCount="@_episodeCount"
                    AssociationCount="@_associationCount"
                    ReplaysTriggered="@_replaysTriggered"
                    AmygdalaPulseActive="@_amygdalaPulseActive"
                    SalientEvents="@_salientEvents"
                    RegionSalience="@_regionSalience"
                    RegionSalienceChanged="@(v => _regionSalience = v)"
                    PredictionError="@_predictionError"
                    SmoothedActivity="@_smoothedActivity"
                    OnApplyThalamus="@ApplyThalamus"
                    OnForceSleep="@ForceSleep"
                    OnBuildSleepPressure="@BuildSleepPressure"
                    OnApplySalience="@ApplySalience" />
            }
            else if (Tab==ConsoleTabs.Voice)
            {
                <VoiceTabPanel
                    BgConfidenceThreshold="@_bgConfThreshold"
                    BgConfidenceThresholdChanged="@(v => _bgConfThreshold = (float)v)"
                    VocalCooldown="@_vocalCooldown"
                    VocalCooldownChanged="@(v => _vocalCooldown = v)"
                    MotorGain="@_motorGain"
                    MotorGainChanged="@(v => _motorGain = (float)v)"
                    M1StripsLeft="@_m1StripsL"
                    M1StripsRight="@_m1StripsR"
                    VoiceLog="@_voiceLog"
                    OnApplyVocalSettings="@ApplyVocalSettings"
                    OnApplyMotorGain="@ApplyMotorGain" />
            }
            else if (Tab==ConsoleTabs.Peer)
            {
                <PeerTabPanel
                    PeerInstanceId="@_peerInstanceId"
                    PeerInstanceName="@_peerInstanceName"
                    PeerNameInput="@_peerNameInput"
                    PeerNameInputChanged="@(v => _peerNameInput = v)"
                    PeerHubInstances="@_peerHubInstances"
                    PeerInfoPeers="@_peerInfoPeers"
                    PeerSayText="@_peerSayText"
                    PeerSayTextChanged="@(v => _peerSayText = v)"
                    VocalTractStatus="@_vocalTractStatus"
                    PeerBasePitch="@_peerBasePitch"
                    PeerBasePitchChanged="@(v => _peerBasePitch = v)"
                    OnSetPeerName="@SetPeerName"
                    OnPeerConnectAll="@PeerConnectAll"
                    OnRefreshPeerHub="@RefreshPeerHub"
                    OnPeerSay="@PeerSay"
                    OnSetPeerPitch="@SetPeerPitch" />
            }
            else if (Tab==ConsoleTabs.View)
            {
                <ViewTabPanel
                    ConnectionFilter="@_connectionFilter"
                    ShowCallosalConn="@_showCallosalConn"
                    ShowCallosalConnChanged="@(v => _showCallosalConn = v)"
                    ShowThalamicConn="@_showThalamicConn"
                    ShowThalamicConnChanged="@(v => _showThalamicConn = v)"
                    ShowHypothalamicConn="@_showHypothalamicConn"
                    ShowHypothalamicConnChanged="@(v => _showHypothalamicConn = v)"
                    ShowHippocampalConn="@_showHippocampalConn"
                    ShowHippocampalConnChanged="@(v => _showHippocampalConn = v)"
                    ShowPontineConn="@_showPontineConn"
                    ShowPontineConnChanged="@(v => _showPontineConn = v)"
                    ShowCerebellarConn="@_showCerebellarConn"
                    ShowCerebellarConnChanged="@(v => _showCerebellarConn = v)"
                    ShowCortex="@_showCortex"
                    ShowCortexChanged="@(v => _showCortex = v)"
                    ShowHippocampus="@_showHippocampus"
                    ShowHippocampusChanged="@(v => _showHippocampus = v)"
                    ShowThalamus="@_showThalamus"
                    ShowThalamusChanged="@(v => _showThalamus = v)"
                    ShowBasalGanglia="@_showBasalGanglia"
                    ShowBasalGangliaChanged="@(v => _showBasalGanglia = v)"
                    ShowAmygdala="@_showAmygdala"
                    ShowAmygdalaChanged="@(v => _showAmygdala = v)"
                    ShowCerebellum="@_showCerebellum"
                    ShowCerebellumChanged="@(v => _showCerebellum = v)"
                    ShowBrainstem="@_showBrainstem"
                    ShowBrainstemChanged="@(v => _showBrainstem = v)"
                    ShowVta="@_showVTA"
                    ShowVtaChanged="@(v => _showVTA = v)"
                    RenderMode="@_renderMode"
                    RenderModeChanged="@OnRenderModeChanged"
                    ShellVisible="@_shellVisible"
                    ShellVisibleChanged="@OnShellVisibleChanged"
                    FibrePulseEnabled="@_fibrePulseEnabled"
                    FibrePulseEnabledChanged="@OnFibrePulseEnabledChanged"
                    OnRefreshRenderer="@RefreshRenderer"
                    OnSetViewPreset="@SetViewPreset"
                    OnShowAllConnections="@ShowAllConnections"
                    OnHideAllConnections="@HideAllConnections"
                    OnShowKeyPathways="@ShowKeyPathways"
                    OnShowLocalConnections="@ShowLocalConnections"
                    OnShowCallosalOnly="@ShowCallosalOnly"
                    OnShowDeepOnly="@ShowDeepOnly"
                    OnConnectionFilterChanged="@OnConnectionFilterChanged"
                    OnOpenAnatomicalViewer="@OpenAnatomicalViewer"
                    OnCircuitToggle="@OnCircuitToggle" />
            }
            else if (Tab==ConsoleTabs.Monitor)
            {
                <MonitorTabPanel
                    ResonantLeft="@_resL"
                    ResonantRight="@_resR"
                    TopThought="@_topThought"
                    Telemetry="@_telemetry"
                    RegionsByRate="@_regionsByRate"
                    OnShowResonant="@ShowResonant"
                    OnShowThoughts="@ShowThoughts"
                    OnFetchTelemetry="@FetchTelemetry" />
            }
    </div></aside>

    <main class="main">
        <div class="canvas-header">
            <h2>Live 3D View</h2>
            <span class="hint">drag · scroll · right-drag</span>
        </div>
        <canvas id="nreCanvas"></canvas>
        <div id="avatarInset" class="avatar-inset" style="display:none">
            <svg id="avatarSvg" viewBox="-60 -10 120 170" width="120" height="165"></svg>
            <div id="avatarEmotions" class="avatar-emotions"></div>
        </div>
    </main>
</div>

@code {

    private static readonly IReadOnlyDictionary<string, object> AttrDisabled =
        new Dictionary<string, object> { ["disabled"] = "disabled" };
private double VisualIntensity { get; set; } = 0.20;
private double VisualSpeedHz { get; set; } = 0.60;
private double VisualSpatialFreq { get; set; } = 3.00;

private double AudioIntensity { get; set; } = 0.20;
private double AudioToneHz { get; set; } = 220;

    // Voice & Motor
    private readonly List<VoiceLogEntry> _voiceLog = new(64);
    private float _bgConfThreshold = 0.30f;
    private int _vocalCooldown = 60;
    private float _motorGain = 1.0f;
    private float[] _m1StripsL = new float[6];
    private float[] _m1StripsR = new float[6];

    // Peer Bridge
    private string _peerInstanceId = "";
    private string? _peerInstanceName;
    private string _peerNameInput = "";
    private string _peerSayText = "";
    private float _peerBasePitch = 120f;
    private string[] _peerHubInstances = Array.Empty<string>();
    private PeerStatusDto[] _peerInfoPeers = Array.Empty<PeerStatusDto>();
    private VocalTractStatusDto? _vocalTractStatus;

    // Live sensory input capture (browser)
    private bool _webcamRunning;
    private bool _micRunning;
    private bool _internetStreamRunning;
    private string _internetStreamUrl = string.Empty;
    private string _apiBase = "http://localhost:5005/";


    private bool _initialized;
    private bool _running;
    private long _step;
    private float _wallClockUptime;
    private float _avgStepMs;
    private float _simRatio = 1f;
    private System.Diagnostics.Stopwatch _uiStopwatch = new();
    private long _lastStepForRatio;
    private double _lastRatioCheckSec;

    private float _dopamine;
    private float _serotonin;
    private float _norad;

    private float _ponsArousal;
    private float _ponsStability;
    private float _ponsReset;
    private float _ponsThetaHz;

    private int _w = 32, _h = 32, _d = 32;

    private float _callosalTraffic;
    private int _resL, _resR;
    private int _thL, _thR;
    private string _topThought = "(none)";
    private TelemetrySnapshotDto? _telemetry;
    private RegionTelemetryDto[] _regionsByRate = Array.Empty<RegionTelemetryDto>();

    private bool _dark = true;
    private string Tab { get; set; } = "Stim";

    private CancellationTokenSource? _cts;
    
    // === SUBSYSTEM STATE ===
    private string _sleepPhase = "Awake";
    private float _sleepPressure;
    private int _consolidationCycles;
    private int _replaysTriggered;
    
    private bool _thalamicPulse;
    private float _thalamicFreq = 40f;
    private float _thalamicFreqTarget = 40f;
    
    private int _episodeCount;
    private int _associationCount;
    private int _totalNeurons;
    private int _totalSynapses;
    
    private bool _amygdalaPulseActive;
    private int _salientEvents;
    private float _regionSalience = 0.5f;
    
    private float _predictionError;
    private float _smoothedActivity;

    // === VIEW TAB STATE ===
    // Neural Renderer controls
    private bool _anatomicalMode = true;
    private bool _brainWarpEnabled = true;
    private bool _gyrificationEnabled = true;
    private float _jitter = 0.25f;
    private string _renderMode = "activity";
    private bool _shellVisible = true;
    private bool _fibrePulseEnabled = true;
    
    // Anatomical Circuit Viewer toggles
    private bool _showCortex = false;
    private bool _showHippocampus = true;
    private bool _showThalamus = true;
    private bool _showBasalGanglia = true;
    private bool _showAmygdala = false;
    private bool _showCerebellum = false;
    private bool _showBrainstem = false;
    private bool _showVTA = false;
    
    // Connection filter state
    private string _connectionFilter = "key";  // "all", "none", "key", "custom"
    private bool _showCallosalConn = true;
    private bool _showThalamicConn = true;
    private bool _showHypothalamicConn = true;
    private bool _showHippocampalConn = true;
    private bool _showPontineConn = true;
    private bool _showCerebellarConn = true;

    // Helper method for sleep phase CSS class
    private string GetSleepClass() => _sleepPhase switch
    {
        "Nrem" => "sleep-nrem",
        "Rem" => "sleep-rem",
        _ => ""
    };

    private static string FormatTime(float seconds)
    {
        if (seconds < 60) return $"{seconds:0.0}s";
        int m = (int)(seconds / 60);
        float s = seconds - m * 60;
        return $"{m}m{s:00.0}s";
    }

    private static float MaxOf(float[] arr)
    {
        float max = 0f;
        for (int i = 0; i < arr.Length; i++)
            if (arr[i] > max) max = arr[i];
        return max;
    }

    protected override async Task OnInitializedAsync()
    {
        _apiBase = Api.BaseAddress;
        var status = await Api.GetStatusAsync();
        if (status is not null)
            ApplyStatus(status);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            _initialized = true;

            await Renderer.SetDarkThemeAsync(_dark);

            // Voice (browser TTS). Non-fatal if unavailable.
            try
            {
                var voiceErr = await Renderer.InitVoiceAsync();
                if (!string.IsNullOrWhiteSpace(voiceErr))
                    _topThought = "Voice unavailable: " + voiceErr;
            }
            catch { }

            // Renderer options:
            // - sagittal split (Option A): hemispheres become half-volumes with a midline fissure
            // - hemisphere fit (Option B): keep warped points inside a hemisphere envelope
            var initErr = await Renderer.InitNeuralRendererSafeAsync(
                "nreCanvas",
                _w, _h, _d,
                new
                {
                    spacing = 2.0,
                    mirrorRight = true,
                    midlineGapVox = 0.90,
                    medialFlattenEnabled = true,
                    medialFlattenStrength = 0.20,
                    superiorFissureBoost = 0.12,
                    fitToHemisphereEnabled = true,
                    fitExponent = 2.35
                });
            // Static layout points so connections terminate on visible neurons
            try
            {
                var layout = await Api.GetLayoutAsync();
                if (layout is not null)
                    await Renderer.SetLayoutAsync(layout);
            }
            catch { }

            if (!string.IsNullOrWhiteSpace(initErr))
                _topThought = "Renderer error: " + initErr;

            await Renderer.SetRenderModeAsync(_renderMode);
            await Renderer.SetShellVisibleAsync(_shellVisible);
            await Renderer.SetFibrePulseEnabledAsync(_fibrePulseEnabled);

            // Fetch connections once (graph is relatively stable)
            try
            {
                var lines = await Api.GetConnectionsAsync(12000);
                if (lines is not null)
                    await Renderer.SetConnectionsAsync(lines);

                    // Apply initial pathway filter (keeps Live view legible)
                    await Renderer.ShowKeyPathwayConnectionsAsync();
            }
            catch
            {
                // ignore if API isn't ready yet; user can refresh page
            }

            _cts = new CancellationTokenSource();
            _ = Task.Run(() => RefreshCoordinator.RunFrameLoopAsync(ApplyFrameAsync, _cts.Token));
            _ = Task.Run(() => RefreshCoordinator.RunStatusLoopAsync(ApplyStatusAsync, _ => FetchTelemetry(), () => InvokeAsync(StateHasChanged), () => Tab, _cts.Token));
            _ = Task.Run(() => RefreshCoordinator.RunVoiceLoopAsync(ApplyVoiceAsync, _cts.Token));
        }
    }

    private Task ApplyVoiceAsync(VoiceUtteranceDto message)
    {
        var surface = string.IsNullOrWhiteSpace(message.Text)
            ? (message.Phonemes is { Length: > 0 } ? string.Join(" ", message.Phonemes) : "[silent]")
            : message.Text;
        var display = !string.IsNullOrWhiteSpace(message.Gloss) && !string.Equals(surface, message.Gloss, StringComparison.OrdinalIgnoreCase)
            ? $"{surface} [{message.Gloss}]"
            : surface;

        _voiceLog.Insert(0, new VoiceLogEntry(
            DateTime.Now.ToString("HH:mm:ss"),
            display));
        if (_voiceLog.Count > 50) _voiceLog.RemoveAt(50);
        return Task.CompletedTask;
    }

    private async Task ApplyFrameAsync(RenderFrameFastDto frame)
    {
        _step = frame.StepIndex;
        _callosalTraffic = frame.CallosalTraffic01;

        if (!_uiStopwatch.IsRunning) _uiStopwatch.Start();
        _wallClockUptime = (float)_uiStopwatch.Elapsed.TotalSeconds;
        float simTimeSec = _step / 60f;
        if (_wallClockUptime > 0.5f)
            _simRatio = simTimeSec / _wallClockUptime;

        double nowSec = _uiStopwatch.Elapsed.TotalSeconds;
        double wallDelta = nowSec - _lastRatioCheckSec;
        if (wallDelta >= 0.5)
        {
            long stepDelta = _step - _lastStepForRatio;
            _avgStepMs = stepDelta > 0 ? (float)(wallDelta * 1000.0 / stepDelta) : 0;
            _lastStepForRatio = _step;
            _lastRatioCheckSec = nowSec;
        }

        _sleepPhase = frame.SleepPhase ?? "Unknown";
        _thalamicPulse = frame.ThalamicPulseActive ?? false;

        await Renderer.UpdateFrameCombinedAsync(frame, _showAvatar);

        if (frame.Body is { Length: >= 14 })
        {
            var bd = frame.Body;
            _m1StripsL = new[] { bd[10], bd[8], bd[12], bd[2], bd[4], bd[0] };
            _m1StripsR = new[] { bd[11], bd[9], bd[13], bd[3], bd[5], bd[1] };
        }
    }

    private Task ApplyStatusAsync(EngineStatusDto status)
    {
        ApplyStatus(status);
        return Task.CompletedTask;
    }

    private async Task ReloadStatusAsync()
    {
        var status = await Api.GetStatusAsync();
        if (status is not null)
            ApplyStatus(status);
    }

    private void ApplyStatus(EngineStatusDto status)
    {
        _running = status.Running;
        _totalNeurons = status.TotalNeurons;
        _totalSynapses = status.TotalSynapses;

        _w = status.VolumeW; _h = status.VolumeH; _d = status.VolumeD;

        _dopamine = status.Neuromodulators.Dopamine;
        _serotonin = status.Neuromodulators.Serotonin;
        _norad = status.Neuromodulators.Noradrenaline;

        _ponsArousal = status.Pons.Arousal;
        _ponsStability = status.Pons.Stability;
        _ponsReset = status.Pons.ResetPressure;
        _ponsThetaHz = status.Pons.ThetaHz;

        if (status.Thalamus is not null)
        {
            _thalamicPulse = status.Thalamus.IsAtPulse;
            _thalamicFreq = status.Thalamus.FrequencyHz;
        }

        if (status.Sleep is not null)
        {
            _sleepPhase = status.Sleep.Phase;
            _sleepPressure = status.Sleep.SleepPressure;
            _consolidationCycles = status.Sleep.ConsolidationCycles;
            _replaysTriggered = status.Sleep.ReplaysTriggered;
        }

        if (status.Hippocampus is not null)
        {
            _episodeCount = status.Hippocampus.EpisodeCount;
            _associationCount = status.Hippocampus.AssociationCount;
        }

        if (status.Amygdala is not null)
        {
            _amygdalaPulseActive = status.Amygdala.NoradrenalinePulseActive;
            _salientEvents = status.Amygdala.SalientEventsPerSecond;
        }

        if (status.Cerebellum is not null)
        {
            _predictionError = status.Cerebellum.GlobalPredictionError;
            _smoothedActivity = status.Cerebellum.SmoothedActivity;
        }

        _vocalTractStatus = status.VocalTract;
        if (status.PeerBridge is not null)
        {
            _peerInstanceId = status.PeerBridge.InstanceId;
            _peerInstanceName = status.PeerBridge.InstanceName;
            _peerInfoPeers = status.PeerBridge.Peers;
        }
    }

    private async Task Start()
    {
        await Api.StartAsync();
        var status = await Api.GetStatusAsync();
        if (status is not null) ApplyStatus(status);
    }

    private async Task Stop()
    {
        await Api.StopAsync();
        var status = await Api.GetStatusAsync();
        if (status is not null) ApplyStatus(status);
    }

    private async Task ToggleDark()
    {
        _dark = !_dark;
        await Renderer.SetDarkThemeAsync(_dark);
    }

    private bool _showAvatar;

    private async Task ToggleAvatar()
    {
        _showAvatar = !_showAvatar;
        if (_showAvatar)
            await Renderer.InitAvatarAsync();
        else
            await Renderer.DestroyAvatarAsync();
    }

    // Save/Load brain state
    private string _saveLoadStatus = "";

    private async Task SaveBrain()
    {
        try
        {
            _saveLoadStatus = "Saving...";
            StateHasChanged();
            
            var response = await Api.SaveBrainAsync();
            if (response.IsSuccessStatusCode)
            {
                var bytes = await response.Content.ReadAsByteArrayAsync();
                var b64 = Convert.ToBase64String(bytes);
                var fileName = $"brain_{DateTime.Now:yyyyMMdd_HHmmss}.nre";
                await Renderer.DownloadBlobAsync(b64, fileName);
                _saveLoadStatus = $"Saved ({bytes.Length / 1024}KB)";
            }
            else
            {
                _saveLoadStatus = "Save failed: " + response.StatusCode;
            }
        }
        catch (Exception ex)
        {
            _saveLoadStatus = "Save error: " + ex.Message;
        }
    }

    private async Task LoadBrainClick()
    {
        await Renderer.FocusBrainFileInputAsync();
    }

    private async Task OnBrainFileSelected(InputFileChangeEventArgs e)
    {
        try
        {
            _saveLoadStatus = "Loading...";
            StateHasChanged();

            var file = e.File;
            if (file.Size > 50_000_000)
            {
                _saveLoadStatus = "File too large (max 50MB)";
                return;
            }

            using var ms = new MemoryStream();
            await file.OpenReadStream(50_000_000).CopyToAsync(ms);
            var bytes = ms.ToArray();

            var content = new ByteArrayContent(bytes);
            content.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("application/octet-stream");
            var response = await Api.LoadBrainAsync(bytes);

            if (response.IsSuccessStatusCode)
            {
                _saveLoadStatus = $"Loaded ({bytes.Length / 1024}KB) — refreshing view...";
                StateHasChanged();
                await Renderer.RefreshAsync();
                _saveLoadStatus = $"Brain loaded successfully ({bytes.Length / 1024}KB)";
            }
            else
            {
                var msg = await response.Content.ReadAsStringAsync();
                _saveLoadStatus = "Load failed: " + msg;
            }
        }
        catch (Exception ex)
        {
            _saveLoadStatus = "Load error: " + ex.Message;
        }
    }

    private async Task ApplyNeuromods()
    {
        await Api.SetNeuromodulatorAsync("dopamine", _dopamine);
        await Api.SetNeuromodulatorAsync("serotonin", _serotonin);
        await Api.SetNeuromodulatorAsync("noradrenaline", _norad);
        var status = await Api.GetStatusAsync();
        if (status is not null) ApplyStatus(status);
    }

    private async Task ApplyPons()
