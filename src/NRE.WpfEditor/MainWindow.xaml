                                                    ClipToBounds="True"
                                                    Focusable="True">
                                            <Viewport3D.Camera>
                                                <PerspectiveCamera x:Name="BrainCamera"
                                                                   Position="0,0,5.2"
                                                                   LookDirection="0,0,-5.2"
                                                                   UpDirection="0,1,0"
                                                                   FieldOfView="45" />
                                            </Viewport3D.Camera>
                                        </Viewport3D>
                                        <Canvas x:Name="HoverOverlayCanvas" IsHitTestVisible="False">
                                            <Border x:Name="HoverLabelBorder"
                                                    Visibility="Collapsed"
                                                    Background="#C615233F"
                                                    BorderBrush="#7FA7D9"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="6,3">
