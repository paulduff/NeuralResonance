    private async Task OnConnectionFilterChanged()
    {
        _connectionFilter = "custom";
        // Region IDs: 1=Thalamus, 2=Hypothalamus, 5=Hippocampus, 8=Pons, 14=CorpusCallosum, 27=Cerebellum
        var regions = new List<int>();
        if (_showCallosalConn) regions.Add(14);
        if (_showThalamicConn) regions.Add(1);
        if (_showHypothalamicConn) regions.Add(2);
        if (_showHippocampalConn) regions.Add(5);
        if (_showPontineConn) regions.Add(8);
        if (_showCerebellarConn) regions.Add(27);

        if (regions.Count == 0)
        {
            await Renderer.SetConnectionFilterAsync("none");
        }
        else
        {
            await Renderer.SetConnectionFilterAsync("regions", regions.ToArray());
        }
    }

