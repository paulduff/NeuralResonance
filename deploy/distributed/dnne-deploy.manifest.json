        "LateralHypothalamicArea",
        "VentromedialHypothalamicNucleus",
        "DorsomedialHypothalamicNucleus",
        "MammillaryBodies",
        "BasolateralAmygdala",
        "CentralAmygdala",
        "MedialAmygdala",
        "CorticalAmygdala",
        "BedNucleusStriaTerminalis",
        "Acc",
        "NucleusAccumbens",
        "VentralPallidum",
        "Striatum",
        "GPe",
        "GPi",
        "Stn",
        "Snr",
        "Snc",
        "Vta",
        "Habenula",
        "LocusCoeruleus",
        "RapheNuclei",
        "NucleusBasalis",
        "PeriaqueductalGray",
        "OlfactoryBulb"
      ]
    }
  ]
}
