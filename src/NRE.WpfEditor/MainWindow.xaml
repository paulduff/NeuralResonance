<Window x:Class="NRE.WpfEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:dock="clr-namespace:AvalonDock;assembly=AvalonDock"
        xmlns:layout="clr-namespace:AvalonDock.Layout;assembly=AvalonDock"
        mc:Ignorable="d"
        Title="Neural Resonance Editor"
        Height="900"
        Width="1400"
        Background="#0B1321">
    <Window.Resources>
        <Style x:Key="DisplayModeSegmentStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Foreground" Value="#AFC0E8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="SegmentBorder"
                                Padding="10,5"
                                Background="#0D1629"
                                BorderBrush="#334264"
                                BorderThickness="1"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SegmentBorder" Property="Background" Value="#315E82" />
                                <Setter TargetName="SegmentBorder" Property="BorderBrush" Value="#74B6DB" />
                                <Setter Property="Foreground" Value="#F4F8FF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SegmentBorder" Property="BorderBrush" Value="#6D8DBA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#111A2E" BorderBrush="#24304E" BorderThickness="0,0,0,1">
            <Grid Margin="12,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="DNNE Editor" FontSize="20" FontWeight="SemiBold" Foreground="#D7E2FF" />
                <TextBlock Grid.Column="1"
                           Margin="16,2,0,0"
                           Text="Dock panes, inspect pathways, and manipulate 3D brain model"
                           Foreground="#8FA3D3" />
            </Grid>
        </Border>

        <Menu DockPanel.Dock="Top"
              Background="#0F172A"
              Foreground="#565A66"
              BorderBrush="#24304E"
              BorderThickness="0,0,0,1">
            <Menu.Resources>
                <Style TargetType="{x:Type MenuItem}">
                    <Setter Property="Foreground" Value="#565A66" />
                </Style>
            </Menu.Resources>
            <MenuItem Header="_File">
                <MenuItem Header="_Open Network..." Click="FileOpenNetworkMenuItem_OnClick" />
                <MenuItem Header="_Save Network..." Click="FileSaveNetworkMenuItem_OnClick" />
                <Separator />
                <MenuItem Header="_Exit" Click="FileExitMenuItem_OnClick" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Copy Output" Click="EditCopyOutputMenuItem_OnClick" />
                <MenuItem Header="_Clear Output" Click="EditClearOutputMenuItem_OnClick" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem x:Name="ViewStructuresMenuItem"
                          Header="Structures"
                          IsCheckable="True"
                          IsChecked="True"
                          Tag="Structures"
                          Checked="ViewPanelMenuItem_OnChecked"
                          Unchecked="ViewPanelMenuItem_OnUnchecked" />
                <MenuItem x:Name="ViewSensoryIoMenuItem"
                          Header="Sensory I/O"
                          IsCheckable="True"
                          IsChecked="True"
                          Tag="SensoryIo"
                          Checked="ViewPanelMenuItem_OnChecked"
                          Unchecked="ViewPanelMenuItem_OnUnchecked" />
                <MenuItem x:Name="ViewTransportStatsMenuItem"
                          Header="Transport Stats"
                          IsCheckable="True"
                          IsChecked="True"
                          Tag="TransportStats"
                          Checked="ViewPanelMenuItem_OnChecked"
                          Unchecked="ViewPanelMenuItem_OnUnchecked" />
                <MenuItem x:Name="ViewBrainDashboardMenuItem"
                          Header="Brain Dashboard"
                          IsCheckable="True"
                          IsChecked="True"
                          Tag="BrainDashboard"
                          Checked="ViewPanelMenuItem_OnChecked"
                          Unchecked="ViewPanelMenuItem_OnUnchecked" />
                <MenuItem x:Name="ViewInhabitanceMenuItem"
                          Header="Inhabitance"
                          IsCheckable="True"
                          IsChecked="True"
                          Tag="Inhabitance"
                          Checked="ViewPanelMenuItem_OnChecked"
                          Unchecked="ViewPanelMenuItem_OnUnchecked" />
                <MenuItem x:Name="ViewCircuitAuditMenuItem"
                          Header="Circuit Audit"
                          IsCheckable="True"
                          IsChecked="True"
                          Tag="CircuitAudit"
                          Checked="ViewPanelMenuItem_OnChecked"
                          Unchecked="ViewPanelMenuItem_OnUnchecked" />
                <MenuItem x:Name="ViewReasoningMenuItem"
                          Header="Reasoning"
                          IsCheckable="True"
                          IsChecked="True"
                          Tag="Reasoning"
                          Checked="ViewPanelMenuItem_OnChecked"
                          Unchecked="ViewPanelMenuItem_OnUnchecked" />
                <Separator />
                <MenuItem x:Name="ViewSpikeLogMenuItem"
                          Header="Spike Log"
                          IsCheckable="True"
                          IsChecked="True"
                          Tag="SpikeLog"
                          Checked="ViewPanelMenuItem_OnChecked"
                          Unchecked="ViewPanelMenuItem_OnUnchecked" />
                <MenuItem x:Name="ViewOutputMenuItem"
                          Header="Output"
                          IsCheckable="True"
                          IsChecked="True"
                          Tag="Output"
                          Checked="ViewPanelMenuItem_OnChecked"
                          Unchecked="ViewPanelMenuItem_OnUnchecked" />
                <MenuItem x:Name="ViewControlBarMenuItem"
                          Header="Control Bar"
                          IsCheckable="True"
                          IsChecked="True"
                          Tag="ControlBar"
                          Checked="ViewPanelMenuItem_OnChecked"
                          Unchecked="ViewPanelMenuItem_OnUnchecked" />
                <MenuItem x:Name="ViewInspectorMenuItem"
                          Header="Inspector"
                          IsCheckable="True"
                          IsChecked="True"
                          Tag="Inspector"
                          Checked="ViewPanelMenuItem_OnChecked"
                          Unchecked="ViewPanelMenuItem_OnUnchecked" />
            </MenuItem>
        </Menu>

        <dock:DockingManager x:Name="DockManager" Background="#0B1321">
            <dock:DockingManager.Layout>
                <layout:LayoutRoot>
                <layout:LayoutPanel Orientation="Horizontal">
                    <layout:LayoutAnchorablePane DockWidth="270">
                        <layout:LayoutAnchorable x:Name="StructuresAnchorable" Title="Structures" CanClose="False" CanHide="True">
                            <Border Padding="8" Background="#111A2E">
                                <TreeView x:Name="StructuresTree"
                                          Foreground="#E2EAFF"
                                          Background="#111A2E"
                                          BorderThickness="0" />
                            </Border>
                        </layout:LayoutAnchorable>
                        <layout:LayoutAnchorable x:Name="SensoryIoAnchorable" Title="Sensory I/O" CanClose="False" CanHide="True">
                            <Border Background="#111A2E" Padding="8">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="Avatar Sight Input" Foreground="#DDE6FF" FontWeight="SemiBold" />
                                        <Border x:Name="WebcamPreviewBorder"
                                                Margin="0,8,0,0"
                                                Width="196"
                                                Height="196"
                                                HorizontalAlignment="Left"
                                                Background="#0E1830"
                                                BorderBrush="#2D3D63"
                                                BorderThickness="1"
                                                CornerRadius="4">
                                            <Grid>
                                                <Image x:Name="WebcamPreviewImage"
                                                       Stretch="Uniform" />
                                                <TextBlock x:Name="WebcamPreviewOverlayText"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="#9EB3E5"
                                                           Text="Avatar sight unavailable" />
                                                <Canvas x:Name="WebcamOverlayCanvas" IsHitTestVisible="False">
                                                    <Rectangle x:Name="WebcamAttentionReticle"
                                                               Visibility="Collapsed"
                                                               RadiusX="6"
                                                               RadiusY="6"
                                                               Stroke="#FF91E7FF"
                                                               StrokeThickness="2.6"
                                                               Fill="#2091E7FF" />
                                                </Canvas>
                                            </Grid>
                                        </Border>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"
                                                       Foreground="#C5D2F2"
                                                       Text="Camera Index" />
                                            <TextBox x:Name="WebcamIndexTextBox"
                                                     Grid.Column="1"
                                                     Background="#14203B"
                                                     Foreground="#DDE6FF"
                                                     BorderBrush="#2D3D63"
                                                     Text="0" />
                                        </Grid>
                                        <TextBlock Margin="0,8,0,4" Text="Frame Size" Foreground="#B9C8ED" />
                                        <ComboBox x:Name="WebcamResolutionCombo"
                                                  SelectedIndex="1"
                                                  SelectionChanged="WebcamResolutionCombo_OnSelectionChanged"
                                                  Foreground="#0E1830"
                                                  Background="#E7EEFF">
                                            <ComboBox.ItemContainerStyle>
                                                <Style TargetType="ComboBoxItem">
                                                    <Setter Property="Foreground" Value="#0E1830" />
                                                    <Setter Property="Background" Value="#E7EEFF" />
                                                </Style>
                                            </ComboBox.ItemContainerStyle>
                                            <ComboBoxItem Content="128 x 128" Tag="128" />
                                            <ComboBoxItem Content="196 x 196" Tag="196" />
                                            <ComboBoxItem Content="256 x 256" Tag="256" />
                                        </ComboBox>
                                        <Button x:Name="ToggleWebcamInputButton"
                                                Margin="0,8,0,0"
                                                Padding="10,4"
                                                Click="ToggleWebcamInputButton_OnClick"
                                                Content="Start Webcam Input" />
                                        <TextBlock x:Name="WebcamStatusText"
                                                   Margin="0,6,0,0"
                                                   Foreground="#9EB3E5"
                                                   Text="Webcam: idle" />

                                        <TextBlock Margin="0,12,0,4" Text="Microphone Input" Foreground="#DDE6FF" FontWeight="SemiBold" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"
                                                       Foreground="#C5D2F2"
                                                       Text="Mic Index" />
                                            <TextBox x:Name="MicrophoneIndexTextBox"
                                                     Grid.Column="1"
                                                     Background="#14203B"
                                                     Foreground="#DDE6FF"
                                                     BorderBrush="#2D3D63"
                                                     Text="0" />
                                        </Grid>
                                        <Button x:Name="ToggleMicrophoneInputButton"
                                                Margin="0,8,0,0"
                                                Padding="10,4"
                                                Click="ToggleMicrophoneInputButton_OnClick"
                                                Content="Start Microphone Input" />
                                        <TextBlock x:Name="MicrophoneStatusText"
                                                   Margin="0,6,0,0"
                                                   Foreground="#9EB3E5"
                                                   Text="Microphone: idle" />
                                        <TextBlock Margin="0,8,0,4" Text="Input Level" Foreground="#B9C8ED" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ProgressBar x:Name="MicrophoneLevelBar"
                                                         Grid.Column="0"
                                                         Height="10"
                                                         Minimum="0"
                                                         Maximum="100"
                                                         Value="0"
                                                         Background="#1A2742"
                                                         Foreground="#6EC8FF"
                                                         BorderBrush="#2D3D63"
                                                         BorderThickness="1" />
                                            <TextBlock x:Name="MicrophoneLevelText"
                                                       Grid.Column="1"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="#C5D2F2"
                                                       Text="0%" />
                                        </Grid>

                                        <TextBlock Margin="0,12,0,4"
                                                   Text="Sensory Health"
                                                   Foreground="#DDE6FF"
                                                   FontWeight="SemiBold" />
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Ellipse x:Name="WebcamHealthLight"
                                                     Grid.Row="0"
                                                     Grid.Column="0"
                                                     Width="10"
                                                     Height="10"
                                                     VerticalAlignment="Center"
                                                     Fill="#64748B"
                                                     Stroke="#364152"
                                                     StrokeThickness="1" />
                                            <TextBlock x:Name="WebcamHealthText"
                                                       Grid.Row="0"
                                                       Grid.Column="1"
                                                       Margin="8,0,0,0"
                                                       Foreground="#9EB3E5"
                                                       Text="Webcam pipeline: inactive" />

                                            <Ellipse x:Name="MicrophoneHealthLight"
                                                     Grid.Row="1"
                                                     Grid.Column="0"
                                                     Margin="0,6,0,0"
                                                     Width="10"
                                                     Height="10"
                                                     VerticalAlignment="Center"
                                                     Fill="#64748B"
                                                     Stroke="#364152"
                                                     StrokeThickness="1" />
                                            <TextBlock x:Name="MicrophoneHealthText"
                                                       Grid.Row="1"
                                                       Grid.Column="1"
                                                       Margin="8,6,0,0"
                                                       Foreground="#9EB3E5"
                                                       Text="Microphone pipeline: inactive" />

                                            <Ellipse x:Name="VisualRouteHealthLight"
                                                     Grid.Row="2"
                                                     Grid.Column="0"
                                                     Margin="0,6,0,0"
                                                     Width="10"
                                                     Height="10"
                                                     VerticalAlignment="Center"
                                                     Fill="#64748B"
                                                     Stroke="#364152"
                                                     StrokeThickness="1" />
                                            <TextBlock x:Name="VisualRouteHealthText"
                                                       Grid.Row="2"
                                                       Grid.Column="1"
                                                       Margin="8,6,0,0"
                                                       Foreground="#9EB3E5"
                                                       Text="V1 route: awaiting webcam input" />
                                        </Grid>

                                        <TextBlock Margin="0,12,0,4"
                                                   Text="Avatar Self"
                                                   Foreground="#DDE6FF"
                                                   FontWeight="SemiBold" />
                                        <Border Background="#0E1830"
                                                BorderBrush="#2D3D63"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="8">
                                            <StackPanel>
                                                <TextBlock x:Name="AvatarSelfMoodText"
                                                           Foreground="#DDE6FF"
                                                           TextWrapping="Wrap"
                                                           Text="Body: unknown" />
                                                <TextBlock x:Name="AvatarSelfAttentionText"
                                                           Margin="0,4,0,0"
                                                           Foreground="#B9C8ED"
                                                           TextWrapping="Wrap"
                                                           Text="Attention: none" />
                                                <TextBlock x:Name="AvatarSelfActionText"
                                                           Margin="0,4,0,0"
                                                           Foreground="#B9C8ED"
                                                           TextWrapping="Wrap"
                                                           Text="Action: resting" />
                                                <TextBlock x:Name="AvatarSelfNeedText"
                                                           Margin="0,4,0,0"
                                                           Foreground="#B9C8ED"
                                                           TextWrapping="Wrap"
                                                           Text="Need: none" />
                                                <TextBlock x:Name="AvatarSelfSensationText"
                                                           Margin="0,4,0,0"
                                                           Foreground="#9EB3E5"
                                                           TextWrapping="Wrap"
                                                           Text="Last: none" />
                                                <TextBlock x:Name="AvatarSelfEventText"
                                                           Margin="0,4,0,0"
                                                           Foreground="#9EB3E5"
                                                           TextWrapping="Wrap"
                                                           Text="Recent: none" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </layout:LayoutAnchorable>
                        <layout:LayoutAnchorable x:Name="TransportStatsAnchorable" Title="Transport Stats" CanClose="False" CanHide="True">
                            <Border Background="#111A2E" Padding="8">
                                <TextBox x:Name="TransportStatsTextBox"
                                         BorderThickness="0"
                                         Background="#0E1830"
                                         Foreground="#D3E0FF"
                                         FontFamily="Consolas"
                                         FontSize="12"
                                         IsReadOnly="True"
                                         IsReadOnlyCaretVisible="True"
                                         AcceptsReturn="True"
                                         TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto" />
                            </Border>
                        </layout:LayoutAnchorable>
                        <layout:LayoutAnchorable x:Name="BrainDashboardAnchorable" Title="Brain Dashboard" CanClose="False" CanHide="True">
                            <Border Background="#111A2E" Padding="8">
                                <TextBox x:Name="BrainDashboardTextBox"
                                         BorderThickness="0"
                                         Background="#0E1830"
                                         Foreground="#D3E0FF"
                                         FontFamily="Consolas"
                                         FontSize="12"
                                         IsReadOnly="True"
                                         IsReadOnlyCaretVisible="True"
                                         AcceptsReturn="True"
                                         TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto" />
                            </Border>
                        </layout:LayoutAnchorable>
                        <layout:LayoutAnchorable x:Name="InhabitanceAnchorable" Title="Inhabitance" CanClose="False" CanHide="True">
                            <Border Background="#111A2E" Padding="8">
                                <TextBox x:Name="InhabitanceTextBox"
                                         BorderThickness="0"
                                         Background="#0E1830"
                                         Foreground="#D3E0FF"
                                         FontFamily="Consolas"
                                         FontSize="12"
                                         IsReadOnly="True"
                                         IsReadOnlyCaretVisible="True"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Disabled" />
                            </Border>
                        </layout:LayoutAnchorable>
                        <layout:LayoutAnchorable x:Name="CircuitAuditAnchorable" Title="Circuit Audit" CanClose="False" CanHide="True">
                            <Border Background="#111A2E" Padding="8">
                                <TextBox x:Name="CircuitAuditTextBox"
                                         BorderThickness="0"
                                         Background="#0E1830"
                                         Foreground="#D3E0FF"
                                         FontFamily="Consolas"
                                         FontSize="12"
                                         IsReadOnly="True"
                                         IsReadOnlyCaretVisible="True"
                                         AcceptsReturn="True"
                                         TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto" />
                            </Border>
                        </layout:LayoutAnchorable>
                        <layout:LayoutAnchorable x:Name="ReasoningAnchorable" Title="Reasoning" CanClose="False" CanHide="True">
                            <Border Background="#111A2E" Padding="8">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBox x:Name="ReasoningTextBox"
                                                 Height="240"
                                                 BorderThickness="0"
                                                 Background="#0E1830"
                                                 Foreground="#D3E0FF"
                                                 FontFamily="Consolas"
                                                 FontSize="12"
                                                 IsReadOnly="True"
                                                 IsReadOnlyCaretVisible="True"
                                                 AcceptsReturn="True"
                                                 TextWrapping="NoWrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Auto" />
                                        <TextBlock x:Name="ReasoningStatusText"
                                                   Margin="0,8,0,0"
                                                   Foreground="#9EB3E5"
                                                   Text="Reasoning controls: awaiting runtime state" />

                                        <TextBlock Margin="0,12,0,4" Text="Planning Workspace" Foreground="#DDE6FF" FontWeight="SemiBold" />
                                        <TextBlock Text="Goal" Foreground="#B9C8ED" />
                                        <TextBox x:Name="ReasoningGoalTextBox"
                                                 Margin="0,4,0,0"
                                                 Background="#14203B"
                                                 Foreground="#DDE6FF"
                                                 BorderBrush="#2D3D63"
                                                 Text="stabilize energy while preserving reward" />
                                        <CheckBox x:Name="ReasoningGoalActiveCheckBox"
                                                  Margin="0,8,0,0"
                                                  Foreground="#C5D2F2"
                                                  Content="Goal Active"
                                                  IsChecked="True" />

                                        <TextBlock Margin="0,10,0,4" Text="Horizon Steps" Foreground="#B9C8ED" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="ReasoningHorizonSlider"
                                                    Grid.Column="0"
                                                    Minimum="1"
                                                    Maximum="16"
                                                    TickFrequency="1"
                                                    IsSnapToTickEnabled="True"
                                                    ValueChanged="ReasoningSlider_OnValueChanged"
                                                    Value="6" />
                                            <TextBlock x:Name="ReasoningHorizonText"
                                                       Grid.Column="1"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="#C5D2F2"
                                                       Text="6" />
                                        </Grid>

                                        <TextBlock Margin="0,10,0,4" Text="Max Branching" Foreground="#B9C8ED" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="ReasoningBranchingSlider"
                                                    Grid.Column="0"
                                                    Minimum="1"
                                                    Maximum="32"
                                                    TickFrequency="1"
                                                    IsSnapToTickEnabled="True"
                                                    ValueChanged="ReasoningSlider_OnValueChanged"
                                                    Value="8" />
                                            <TextBlock x:Name="ReasoningBranchingText"
                                                       Grid.Column="1"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="#C5D2F2"
                                                       Text="8" />
                                        </Grid>

                                        <TextBlock Margin="0,10,0,4" Text="Exploration Temperature" Foreground="#B9C8ED" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="ReasoningExplorationSlider"
                                                    Grid.Column="0"
                                                    Minimum="0.05"
                                                    Maximum="2.00"
                                                    ValueChanged="ReasoningSlider_OnValueChanged"
                                                    Value="0.40" />
                                            <TextBlock x:Name="ReasoningExplorationText"
                                                       Grid.Column="1"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="#C5D2F2"
                                                       Text="0.40" />
                                        </Grid>

                                        <TextBlock Margin="0,10,0,4" Text="Dopamine Bias" Foreground="#B9C8ED" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="ReasoningDopamineSlider"
                                                    Grid.Column="0"
                                                    Minimum="0.00"
                                                    Maximum="2.50"
                                                    ValueChanged="ReasoningSlider_OnValueChanged"
                                                    Value="1.00" />
                                            <TextBlock x:Name="ReasoningDopamineText"
                                                       Grid.Column="1"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="#C5D2F2"
                                                       Text="1.00" />
                                        </Grid>

                                        <TextBlock Margin="0,10,0,4" Text="Inhibitory Gate" Foreground="#B9C8ED" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="ReasoningInhibitorySlider"
                                                    Grid.Column="0"
                                                    Minimum="0.00"
                                                    Maximum="2.50"
                                                    ValueChanged="ReasoningSlider_OnValueChanged"
                                                    Value="1.00" />
                                            <TextBlock x:Name="ReasoningInhibitoryText"
                                                       Grid.Column="1"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="#C5D2F2"
                                                       Text="1.00" />
                                        </Grid>

                                        <Button Margin="0,10,0,0"
                                                Padding="8,4"
                                                Click="ReasoningApplyPlanningButton_OnClick"
                                                Content="Apply Planning" />

                                        <TextBlock Margin="0,14,0,4" Text="Curriculum" Foreground="#DDE6FF" FontWeight="SemiBold" />
                                        <CheckBox x:Name="ReasoningCurriculumEnabledCheckBox"
                                                  Foreground="#C5D2F2"
                                                  Content="Curriculum Enabled"
                                                  IsChecked="True" />
                                        <TextBlock Margin="0,10,0,4" Text="Stage Index" Foreground="#B9C8ED" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="ReasoningCurriculumStageSlider"
                                                    Grid.Column="0"
                                                    Minimum="0"
                                                    Maximum="3"
                                                    TickFrequency="1"
                                                    IsSnapToTickEnabled="True"
                                                    ValueChanged="ReasoningSlider_OnValueChanged"
