private async Task StartInternetStream()
{
    if (_internetStreamRunning) return;
    if (string.IsNullOrWhiteSpace(_internetStreamUrl))
    {
        _topThought = "Enter an internet media stream URL first.";
        return;
    }

    try
    {
        if (_webcamRunning) await StopWebcam();
        if (_micRunning) await StopMic();

        await Renderer.StartInternetStreamAsync(_apiBase, _internetStreamUrl, new
        {
            fps = 4,
            width = 96,
            height = 96,
            enableVisual = true,
            enableAudio = true,
            allowAudioPlayback = false,
            crossOrigin = "anonymous"
        });

        _internetStreamRunning = true;
    }
    catch (Exception ex)
    {
        _topThought = "Internet stream error: " + ex.Message;
    }
}

