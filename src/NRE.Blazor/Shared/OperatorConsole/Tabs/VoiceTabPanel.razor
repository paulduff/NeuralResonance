@using NRE.Blazor.Shared.OperatorConsole

<div class="panel">
    <div class="group-title">🗣️ Voice & Motor</div>

    <div class="group-title" style="margin-top:8px">Vocal Sensitivity</div>
    <div class="row">
        <label class="lbl">BG Confidence @BgConfidenceThreshold.ToString("0.00")</label>
        <input type="range" min="0.05" max="0.95" step="0.01" value="@BgConfidenceThreshold" @oninput="OnBgConfidenceInput" />
    </div>
    <div class="row">
        <label class="lbl">Cooldown Steps @VocalCooldown</label>
        <input type="range" min="10" max="600" step="10" value="@VocalCooldown" @oninput="OnVocalCooldownInput" />
    </div>
    <div class="row">
        <button class="btn" @onclick="OnApplyVocalSettings">Apply</button>
    </div>
    <div class="small">Lower BG confidence = speaks more freely. Lower cooldown = shorter gap between utterances.</div>

    <div class="group-title" style="margin-top:10px">Motor Gain</div>
    <div class="row">
        <label class="lbl">Body Gain @MotorGain.ToString("0.0")x</label>
        <input type="range" min="0.5" max="10.0" step="0.5" value="@MotorGain" @oninput="OnMotorGainInput" />
    </div>
    <div class="row">
        <button class="btn" @onclick="OnApplyMotorGain">Apply</button>
    </div>
    <div class="small">Multiplies M1 strip activations. Higher = more visible movement from the same neural activity.</div>

    <div class="group-title" style="margin-top:10px">Brainstem Motor Output (live)</div>
    <div style="font-family:var(--font-mono);font-size:0.65rem;line-height:1.5">
        <div style="margin-bottom:3px"><b>Left BS → Right Body</b></div>
        @for (int i = 0; i < 6; i++)
        {
            var v = i < M1StripsLeft.Length ? M1StripsLeft[i] : 0f;
            var w = Math.Clamp(Math.Abs(v) * 100, 0, 100);
            <div style="display:flex;align-items:center;gap:4px">
                <span style="width:52px">@StripNames[i]</span>
                <div style="flex:1;height:6px;background:var(--border);border-radius:3px;overflow:hidden">
                    <div style="width:@(w.ToString("0"))%;height:100%;background:var(--accent);border-radius:3px"></div>
                </div>
                <span style="width:40px;text-align:right">@v.ToString("0.00")</span>
            </div>
        }
        <div style="margin:5px 0 3px"><b>Right BS → Left Body</b></div>
        @for (int i = 0; i < 6; i++)
        {
            var v = i < M1StripsRight.Length ? M1StripsRight[i] : 0f;
            var w = Math.Clamp(Math.Abs(v) * 100, 0, 100);
            <div style="display:flex;align-items:center;gap:4px">
                <span style="width:52px">@StripNames[i]</span>
                <div style="flex:1;height:6px;background:var(--border);border-radius:3px;overflow:hidden">
                    <div style="width:@(w.ToString("0"))%;height:100%;background:var(--accent2, #6a9);border-radius:3px"></div>
                </div>
                <span style="width:40px;text-align:right">@v.ToString("0.00")</span>
            </div>
        }
    </div>

    <div class="group-title" style="margin-top:10px">Voice Log</div>
    <div class="voice-log" style="max-height:200px;overflow-y:auto;font-family:var(--font-mono);font-size:0.65rem;line-height:1.4">
        @if (VoiceLog.Count == 0)
        {
            <div class="small" style="opacity:0.5">No utterances yet…</div>
        }
        @foreach (var entry in VoiceLog)
        {
            <div style="border-bottom:1px solid var(--border);padding:2px 0">
                <span style="opacity:0.5">@entry.Time</span> <span style="color:var(--accent)">@entry.Text</span>
            </div>
        }
    </div>
</div>

@code {
    private static readonly string[] StripNames = ["Leg", "Hip", "Trunk", "Shoulder", "Arm", "Face"];

    [Parameter] public double BgConfidenceThreshold { get; set; }
    [Parameter] public EventCallback<double> BgConfidenceThresholdChanged { get; set; }
    [Parameter] public int VocalCooldown { get; set; }
    [Parameter] public EventCallback<int> VocalCooldownChanged { get; set; }
    [Parameter] public double MotorGain { get; set; }
    [Parameter] public EventCallback<double> MotorGainChanged { get; set; }
    [Parameter] public float[] M1StripsLeft { get; set; } = Array.Empty<float>();
    [Parameter] public float[] M1StripsRight { get; set; } = Array.Empty<float>();
    [Parameter] public IReadOnlyList<VoiceLogEntry> VoiceLog { get; set; } = Array.Empty<VoiceLogEntry>();
    [Parameter] public EventCallback OnApplyVocalSettings { get; set; }
    [Parameter] public EventCallback OnApplyMotorGain { get; set; }

    private Task OnBgConfidenceInput(ChangeEventArgs e)
        => BgConfidenceThresholdChanged.InvokeAsync(ParseDouble(e.Value, BgConfidenceThreshold));

    private Task OnVocalCooldownInput(ChangeEventArgs e)
        => VocalCooldownChanged.InvokeAsync(ParseInt(e.Value, VocalCooldown));

    private Task OnMotorGainInput(ChangeEventArgs e)
        => MotorGainChanged.InvokeAsync(ParseDouble(e.Value, MotorGain));

    private static double ParseDouble(object? value, double fallback)
        => double.TryParse(Convert.ToString(value, System.Globalization.CultureInfo.InvariantCulture), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var parsed)
            ? parsed
            : fallback;

    private static int ParseInt(object? value, int fallback)
        => int.TryParse(Convert.ToString(value, System.Globalization.CultureInfo.InvariantCulture), System.Globalization.NumberStyles.Integer, System.Globalization.CultureInfo.InvariantCulture, out var parsed)
            ? parsed
            : fallback;
}
