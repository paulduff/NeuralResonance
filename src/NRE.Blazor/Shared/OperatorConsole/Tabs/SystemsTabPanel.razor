<div class="panel">
    <div class="group-title"><span class="swatch" style="background:#8c7533;display:inline-block;vertical-align:middle;margin-right:6px"></span>Thalamus (40Hz Clock)</div>
    <div class="small">Binding: @(ThalamicPulse ? "Active ●" : "Inactive ○") | Freq: @ThalamicFreq.ToString("0")Hz</div>
    <label>Frequency @(ThalamicFreqTarget.ToString("0"))Hz
        <input type="range" min="20" max="80" step="1" value="@ThalamicFreqTarget" @oninput="OnThalamicFreqInput" />
    </label>
    <div class="row">
        <button class="btn" @onclick="OnApplyThalamus">Apply Thalamus</button>
    </div>

    <div class="group-title"><span class="swatch" style="background:#5c7a7a;display:inline-block;vertical-align:middle;margin-right:6px"></span>Sleep/Wake Cycle (Pons)</div>
    <div class="small">Phase: <b class="@SleepClass">@SleepPhase</b> | Pressure: @SleepPressure.ToString("0.00") | Cycles: @ConsolidationCycles</div>
    <div class="progress-bar">
        <div class="fill" style="background:linear-gradient(90deg,#5a7aef,#dc5a96);width:@((SleepPressure * 100).ToString("0"))%"></div>
    </div>
    <div class="row">
        <button class="btn sleep-btn-wake" @onclick="OnForceSleepAwake">☀ Wake</button>
        <button class="btn sleep-btn-nrem" @onclick="OnForceSleepNrem">💤 NREM</button>
        <button class="btn sleep-btn-rem" @onclick="OnForceSleepRem">🌙 REM</button>
        <button class="btn" @onclick="OnBuildSleepPressure" title="Manually increase sleep pressure">⏫ +Pressure</button>
    </div>

    <div class="group-title"><span class="swatch" style="background:#388c4d;display:inline-block;vertical-align:middle;margin-right:6px"></span>Hippocampus (Memory)</div>
    <div class="small">Episodes: @EpisodeCount | Associations: @AssociationCount | Replays: @ReplaysTriggered</div>

    <div class="group-title"><span class="swatch" style="background:#8c3838;display:inline-block;vertical-align:middle;margin-right:6px"></span>Amygdala (Salience)</div>
    <div class="small">Pulse: @(AmygdalaPulseActive ? "Active ●" : "Idle ○") | Events/s: @SalientEvents</div>
    <label>Region Salience (Visual display=1) @(RegionSalience.ToString("0.0"))
        <input type="range" min="0" max="1" step="0.1" value="@RegionSalience" @oninput="OnRegionSalienceInput" />
    </label>
    <div class="row">
        <button class="btn" @onclick="OnApplySalience">Set Visual Salience</button>
    </div>

    <div class="group-title"><span class="swatch" style="background:#73598c;display:inline-block;vertical-align:middle;margin-right:6px"></span>Cerebellum (Smoothing)</div>
    <div class="small">Prediction Error: @PredictionError.ToString("0.000") | Smoothed Activity: @SmoothedActivity.ToString("0.000")</div>
</div>

@code {
    [Parameter] public bool ThalamicPulse { get; set; }
    [Parameter] public float ThalamicFreq { get; set; }
    [Parameter] public float ThalamicFreqTarget { get; set; }
    [Parameter] public EventCallback<float> ThalamicFreqTargetChanged { get; set; }
    [Parameter] public string SleepPhase { get; set; } = "Unknown";
    [Parameter] public string SleepClass { get; set; } = string.Empty;
    [Parameter] public float SleepPressure { get; set; }
    [Parameter] public int ConsolidationCycles { get; set; }
    [Parameter] public int EpisodeCount { get; set; }
    [Parameter] public int AssociationCount { get; set; }
    [Parameter] public int ReplaysTriggered { get; set; }
    [Parameter] public bool AmygdalaPulseActive { get; set; }
    [Parameter] public int SalientEvents { get; set; }
    [Parameter] public float RegionSalience { get; set; }
    [Parameter] public EventCallback<float> RegionSalienceChanged { get; set; }
    [Parameter] public float PredictionError { get; set; }
    [Parameter] public float SmoothedActivity { get; set; }
    [Parameter] public EventCallback OnApplyThalamus { get; set; }
    [Parameter] public EventCallback<string> OnForceSleep { get; set; }
    [Parameter] public EventCallback OnBuildSleepPressure { get; set; }
    [Parameter] public EventCallback OnApplySalience { get; set; }

    private Task OnThalamicFreqInput(ChangeEventArgs e) => ThalamicFreqTargetChanged.InvokeAsync(ParseFloat(e.Value, ThalamicFreqTarget));
    private Task OnRegionSalienceInput(ChangeEventArgs e) => RegionSalienceChanged.InvokeAsync(ParseFloat(e.Value, RegionSalience));

    private Task OnForceSleepAwake() => OnForceSleep.InvokeAsync("Awake");
    private Task OnForceSleepNrem() => OnForceSleep.InvokeAsync("Nrem");
    private Task OnForceSleepRem() => OnForceSleep.InvokeAsync("Rem");

    private static float ParseFloat(object? value, float fallback)
        => float.TryParse(Convert.ToString(value, System.Globalization.CultureInfo.InvariantCulture), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var parsed)
            ? parsed
            : fallback;
}
