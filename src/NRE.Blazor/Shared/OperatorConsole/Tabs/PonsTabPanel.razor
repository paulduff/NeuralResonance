<div class="panel">
    <label>Pons Arousal @(PonsArousal.ToString("0.00"))
        <input type="range" min="0" max="1" step="0.01" value="@PonsArousal" @oninput="OnArousalInput" />
    </label>
    <label>Pons Stability @(PonsStability.ToString("0.00"))
        <input type="range" min="0" max="1" step="0.01" value="@PonsStability" @oninput="OnStabilityInput" />
    </label>
    <label>Pons Reset @(PonsReset.ToString("0.00"))
        <input type="range" min="0" max="1" step="0.01" value="@PonsReset" @oninput="OnResetInput" />
    </label>
    <label>Theta Hz @(PonsThetaHz.ToString("0.0"))
        <input type="range" min="0.5" max="10" step="0.1" value="@PonsThetaHz" @oninput="OnThetaInput" />
    </label>
    <div class="row">
        <button class="btn" @onclick="OnApply">Apply</button>
    </div>
</div>

@code {
    [Parameter] public double PonsArousal { get; set; }
    [Parameter] public EventCallback<double> PonsArousalChanged { get; set; }
    [Parameter] public double PonsStability { get; set; }
    [Parameter] public EventCallback<double> PonsStabilityChanged { get; set; }
    [Parameter] public double PonsReset { get; set; }
    [Parameter] public EventCallback<double> PonsResetChanged { get; set; }
    [Parameter] public double PonsThetaHz { get; set; }
    [Parameter] public EventCallback<double> PonsThetaHzChanged { get; set; }
    [Parameter] public EventCallback OnApply { get; set; }

    private Task OnArousalInput(ChangeEventArgs e) => PonsArousalChanged.InvokeAsync(ParseDouble(e.Value, PonsArousal));
    private Task OnStabilityInput(ChangeEventArgs e) => PonsStabilityChanged.InvokeAsync(ParseDouble(e.Value, PonsStability));
    private Task OnResetInput(ChangeEventArgs e) => PonsResetChanged.InvokeAsync(ParseDouble(e.Value, PonsReset));
    private Task OnThetaInput(ChangeEventArgs e) => PonsThetaHzChanged.InvokeAsync(ParseDouble(e.Value, PonsThetaHz));

    private static double ParseDouble(object? value, double fallback)
        => double.TryParse(Convert.ToString(value, System.Globalization.CultureInfo.InvariantCulture), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var parsed)
            ? parsed
            : fallback;
}
