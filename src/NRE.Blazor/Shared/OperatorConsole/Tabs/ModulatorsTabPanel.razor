<div class="panel">
    <label>Dopamine @(Dopamine.ToString("0.00"))
        <input type="range" min="0" max="1" step="0.01" value="@Dopamine" @oninput="OnDopamineInput" />
    </label>
    <label>Serotonin @(Serotonin.ToString("0.00"))
        <input type="range" min="0" max="1" step="0.01" value="@Serotonin" @oninput="OnSerotoninInput" />
    </label>
    <label>Noradrenaline @(Noradrenaline.ToString("0.00"))
        <input type="range" min="0" max="1" step="0.01" value="@Noradrenaline" @oninput="OnNoradrenalineInput" />
    </label>
    <div class="row">
        <button class="btn" @onclick="OnApply">Apply</button>
    </div>
</div>

@code {
    [Parameter] public double Dopamine { get; set; }
    [Parameter] public EventCallback<double> DopamineChanged { get; set; }
    [Parameter] public double Serotonin { get; set; }
    [Parameter] public EventCallback<double> SerotoninChanged { get; set; }
    [Parameter] public double Noradrenaline { get; set; }
    [Parameter] public EventCallback<double> NoradrenalineChanged { get; set; }
    [Parameter] public EventCallback OnApply { get; set; }

    private Task OnDopamineInput(ChangeEventArgs e) => DopamineChanged.InvokeAsync(ParseDouble(e.Value, Dopamine));
    private Task OnSerotoninInput(ChangeEventArgs e) => SerotoninChanged.InvokeAsync(ParseDouble(e.Value, Serotonin));
    private Task OnNoradrenalineInput(ChangeEventArgs e) => NoradrenalineChanged.InvokeAsync(ParseDouble(e.Value, Noradrenaline));

    private static double ParseDouble(object? value, double fallback)
        => double.TryParse(Convert.ToString(value, System.Globalization.CultureInfo.InvariantCulture), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var parsed)
            ? parsed
            : fallback;
}
