@using NRE.Blazor.Shared.OperatorConsole

<div class="panel">
    <div class="group-title">🔗 Peer Bridge</div>
    <div class="small">Instance: <b>@PeerInstanceId</b> @(PeerInstanceName != null ? $"({PeerInstanceName})" : "")</div>

    <div class="row" style="margin-top:6px">
        <input type="text" value="@PeerNameInput" @oninput="OnPeerNameInputChanged" placeholder="Instance name" style="flex:1;padding:2px 6px;background:var(--bg2);border:1px solid var(--border);color:var(--text);border-radius:3px" />
        <button class="btn" @onclick="OnSetPeerName">Set Name</button>
    </div>

    <div class="group-title" style="margin-top:8px">Connections</div>
    <div class="row">
        <button class="btn" @onclick="OnPeerConnectAll">Connect All</button>
        <button class="btn" @onclick="OnRefreshPeerHub">Refresh Hub</button>
    </div>

    <div class="small" style="margin-top:4px">Hub instances: @PeerHubInstances.Length</div>
    @foreach (var id in PeerHubInstances)
    {
        <div style="font-family:var(--font-mono);font-size:0.65rem;padding:1px 0">
            @id @(id == PeerInstanceId ? "(self)" : "")
        </div>
    }

    <div class="group-title" style="margin-top:8px">Connected Peers: @PeerInfoPeers.Length</div>
    @foreach (var p in PeerInfoPeers)
    {
        <div style="border:1px solid var(--border);border-radius:4px;padding:4px 6px;margin-bottom:4px;font-size:0.70rem">
            <div><b>@(p.Name ?? p.Id)</b> — last heard @p.LastHeardAt</div>
            <div style="display:flex;gap:8px;font-family:var(--font-mono);font-size:0.6rem;opacity:0.8">
                <span>📤 @p.SpeechSent</span>
                <span>📥 @p.SpeechReceived</span>
                <span>🧠 A:@p.Arousal.ToString("0.00")</span>
                <span>V:@p.Valence.ToString("0.00")</span>
                @if (p.IsSpeaking)
                {
                    <span style="color:var(--accent)">🗣️ speaking</span>
                }
            </div>
        </div>
    }

    <div class="group-title" style="margin-top:8px">Send Speech to Peers</div>
    <div class="row">
        <input type="text" value="@PeerSayText" @oninput="OnPeerSayTextChanged" placeholder="Type message..." style="flex:1;padding:2px 6px;background:var(--bg2);border:1px solid var(--border);color:var(--text);border-radius:3px" />
        <button class="btn" @onclick="OnPeerSay">Say</button>
    </div>

    <div class="group-title" style="margin-top:10px">🎤 Vocal Tract</div>
    @if (VocalTractStatus is not null)
    {
        var vt = VocalTractStatus;
        var artVals = new[] { vt.JawOpen, vt.TongueHeight, vt.TongueAdvance, vt.LipRound, vt.VelumHeight, vt.Voicing };
        <div style="font-family:var(--font-mono);font-size:0.65rem;line-height:1.5">
            <div>@(vt.IsSpeaking ? "🔊 Speaking" : "🔇 Silent") — Pending: @vt.PendingGestures gestures</div>
            <div style="margin-top:3px">Formants: F0=@vt.F0.ToString("0")Hz F1=@vt.F1.ToString("0")Hz F2=@vt.F2.ToString("0")Hz F3=@vt.F3.ToString("0")Hz</div>
            <div style="margin-top:3px">Articulators:</div>
            @for (int i = 0; i < ArticulatorNames.Length; i++)
            {
                var av = artVals[i];
                var aw = Math.Clamp(av * 100, 0, 100);
                <div style="display:flex;align-items:center;gap:4px">
                    <span style="width:42px">@ArticulatorNames[i]</span>
                    <div style="flex:1;height:5px;background:var(--border);border-radius:3px;overflow:hidden">
                        <div style="width:@(aw.ToString("0"))%;height:100%;background:var(--accent);border-radius:3px"></div>
                    </div>
                    <span style="width:32px;text-align:right">@av.ToString("0.00")</span>
                </div>
            }
        </div>
    }

    <div class="group-title" style="margin-top:8px">Pitch</div>
    <div class="row">
        <label class="lbl">Base Pitch @PeerBasePitch.ToString("0")Hz</label>
        <input type="range" min="50" max="300" step="5" value="@PeerBasePitch" @oninput="OnPeerBasePitchInput" />
    </div>
    <div class="row">
        <button class="btn" @onclick="OnSetPeerPitch">Apply</button>
    </div>
</div>

@code {
    private static readonly string[] ArticulatorNames = ["Jaw", "TnHt", "TnAdv", "Lips", "Velum", "Voice"];

    [Parameter] public string PeerInstanceId { get; set; } = string.Empty;
    [Parameter] public string? PeerInstanceName { get; set; }
    [Parameter] public string PeerNameInput { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> PeerNameInputChanged { get; set; }
    [Parameter] public string[] PeerHubInstances { get; set; } = Array.Empty<string>();
    [Parameter] public PeerStatusDto[] PeerInfoPeers { get; set; } = Array.Empty<PeerStatusDto>();
    [Parameter] public string PeerSayText { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> PeerSayTextChanged { get; set; }
    [Parameter] public VocalTractStatusDto? VocalTractStatus { get; set; }
    [Parameter] public float PeerBasePitch { get; set; }
    [Parameter] public EventCallback<float> PeerBasePitchChanged { get; set; }
    [Parameter] public EventCallback OnSetPeerName { get; set; }
    [Parameter] public EventCallback OnPeerConnectAll { get; set; }
    [Parameter] public EventCallback OnRefreshPeerHub { get; set; }
    [Parameter] public EventCallback OnPeerSay { get; set; }
    [Parameter] public EventCallback OnSetPeerPitch { get; set; }

    private Task OnPeerNameInputChanged(ChangeEventArgs e)
        => PeerNameInputChanged.InvokeAsync(Convert.ToString(e.Value, System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty);

    private Task OnPeerSayTextChanged(ChangeEventArgs e)
        => PeerSayTextChanged.InvokeAsync(Convert.ToString(e.Value, System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty);

    private Task OnPeerBasePitchInput(ChangeEventArgs e)
        => PeerBasePitchChanged.InvokeAsync(ParseFloat(e.Value, PeerBasePitch));

    private static float ParseFloat(object? value, float fallback)
        => float.TryParse(Convert.ToString(value, System.Globalization.CultureInfo.InvariantCulture), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var parsed)
            ? parsed
            : fallback;
}
