<Window x:Class="NRE.WpfMazeSim.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="NRE Maze Simulator"
        Height="920"
        Width="1480"
        Background="#071635"
        Foreground="#D8E6FF"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D8E6FF" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="170" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0B1E45" BorderBrush="#1B2E56" BorderThickness="0,0,0,1" Padding="10,8">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Control Endpoint" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <ComboBox x:Name="EndpointComboBox" Width="220" SelectedIndex="0">
                        <ComboBoxItem Content="http://localhost:5080" />
                        <ComboBoxItem Content="https://localhost:5081" />
                    </ComboBox>
                    <Button x:Name="ReconnectButton" Content="Reconnect" Margin="10,0,0,0" Padding="10,2" Click="ReconnectButton_OnClick" />
                    <Button x:Name="ResetAvatarButton" Content="Reset Avatar" Margin="8,0,0,0" Padding="10,2" Click="ResetAvatarButton_OnClick" />
                </StackPanel>
                <TextBlock x:Name="ConnectionStatusText"
                           DockPanel.Dock="Right"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="Status: Initializing..." />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="8" BorderBrush="#1A2F5D" BorderThickness="1" CornerRadius="4" Background="#04112B">
                <Viewport3D x:Name="MazeViewport" ClipToBounds="True" />
            </Border>

            <Border Grid.Column="1" Margin="0,8,8,8" Padding="10" BorderBrush="#1A2F5D" BorderThickness="1" CornerRadius="4" Background="#081A3F">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Maze Brain Drive" FontSize="16" FontWeight="Bold" />
                        <TextBlock x:Name="TickText" Margin="0,8,0,0" Text="Tick: -" />
                        <TextBlock x:Name="DispatchText" Margin="0,4,0,0" Text="Dispatch spikes: -" />
                        <TextBlock x:Name="MotorText" Margin="0,4,0,0" Text="Motor L/R: -" />
                        <TextBlock x:Name="MoveText" Margin="0,4,0,0" Text="Speed/Turn: -" />
                        <TextBlock x:Name="PoseText" Margin="0,4,0,0" Text="Avatar pose: -" />
                        <TextBlock x:Name="ScoreText" Margin="0,4,0,0" Text="Score: -" />
                        <TextBlock x:Name="HealthText" Margin="0,4,0,0" Text="Health: -" />
                        <TextBlock x:Name="CheckpointText" Margin="0,4,0,0" Text="Checkpoint: -" />
                        <TextBlock x:Name="EventText" Margin="0,4,0,0" Text="Event: -" TextWrapping="Wrap" />
                        <Separator Margin="0,10,0,10" />
                        <TextBlock Text="Learning Progress" FontWeight="SemiBold" />
                        <TextBlock x:Name="CollisionRateText" Margin="0,4,0,0" Text="Collision rate: -" TextWrapping="Wrap" />
                        <TextBlock x:Name="PathEfficiencyText" Margin="0,4,0,0" Text="Path efficiency: -" TextWrapping="Wrap" />
                        <TextBlock x:Name="RewardTrendText" Margin="0,4,0,0" Text="Reward trend: -" TextWrapping="Wrap" />
                        <Separator Margin="0,10,0,10" />

                        <TextBlock Text="Avatar Vision" FontWeight="SemiBold" />
                        <CheckBox x:Name="VisionInputCheckBox"
                                  IsChecked="True"
                                  Content="Send avatar vision to brain (V1)"
                                  Margin="0,6,0,6" />
                        <Border Width="196"
                                Height="196"
                                BorderBrush="#1D335F"
                                BorderThickness="1"
                                CornerRadius="2"
                                Background="#020B1F">
                            <Image x:Name="VisionPreviewImage"
                                   Stretch="Fill"
                                   SnapsToDevicePixels="True"
                                   UseLayoutRounding="True" />
                        </Border>
                        <TextBlock x:Name="VisionSignalText" Margin="0,6,0,0" Text="Vision signal: -" TextWrapping="Wrap" />
                        <TextBlock x:Name="VisionInputStatusText" Margin="0,2,0,0" Text="Visual input: -" TextWrapping="Wrap" />

                        <!-- Pixel-level vision: posts the raw rendered preview as grayscale bytes
                             to NRE.Api so the brain's V1 Gabor hierarchy + retinotopic occipital
                             injection see actual pixels rather than symbolic intensity/saliency.
                             Independent of the V1 symbolic dispatch above. -->
                        <TextBlock Text="Pixel-Vision (NRE.Api — removed)" FontWeight="SemiBold" Margin="0,10,0,0" />
                        <CheckBox x:Name="PixelVisionCheckBox"
                                  IsChecked="False"
                                  Content="Send pixel vision to NRE.Api (no live target)"
                                  Margin="0,6,0,0"
                                  Checked="PixelVisionCheckBox_OnChecked"
                                  Unchecked="PixelVisionCheckBox_OnUnchecked" />
                        <DockPanel Margin="0,4,0,0">
                            <TextBlock Text="Endpoint:" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox x:Name="PixelVisionEndpointTextBox"
                                     Text="http://localhost:5005"
                                     LostFocus="PixelVisionEndpointTextBox_OnLostFocus"
                                     KeyDown="PixelVisionEndpointTextBox_OnKeyDown" />
                        </DockPanel>
                        <Separator Margin="0,10,0,10" />
                        <TextBlock Text="Object Memory" FontWeight="SemiBold" />
                        <TextBox x:Name="ObjectMemoryTextBox"
                                 Margin="0,6,0,0"
                                 MinHeight="112"
                                 MaxHeight="190"
                                 Background="#030E24"
                                 Foreground="#D8E6FF"
                                 BorderBrush="#1D335F"
                                 BorderThickness="1"
                                 FontFamily="Consolas"
                                 FontSize="11"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"
                                 Text="Object memory: waiting for first frame" />
                        <Separator Margin="0,10,0,10" />

                        <TextBlock x:Name="LimbicStageText" Margin="0,2,0,0" Text="Limbic stage: -" />
                        <TextBlock x:Name="LimbicDriveText" Margin="0,2,0,0" Text="Limbic drives: -" TextWrapping="Wrap" />
                        <TextBlock x:Name="BrainNarrationText" Margin="0,4,0,0" Text="Brain narration: -" TextWrapping="Wrap" />
                        <TextBlock Margin="0,8,0,0" Text="English Command" FontWeight="SemiBold" />
                        <TextBox x:Name="EnglishCommandTextBox"
                                 Margin="0,4,0,0"
                                 Padding="6,4"
                                 Background="#030E24"
                                 Foreground="#D8E6FF"
                                 BorderBrush="#1D335F"
                                 Text="move forward"
                                 KeyDown="EnglishCommandTextBox_OnKeyDown" />
                        <Button x:Name="SendEnglishCommandButton"
                                Margin="0,4,0,0"
                                Padding="8,3"
                                Content="Send English Command"
                                Click="SendEnglishCommandButton_OnClick" />
                        <TextBlock x:Name="EnglishCommandStatusText" Margin="0,3,0,8" Text="Command: idle" TextWrapping="Wrap" />

                        <TextBlock Text="Forward Gain" />
                        <Slider x:Name="ForwardGainSlider" Minimum="0.1" Maximum="3.0" Value="1.2" TickFrequency="0.1" IsSnapToTickEnabled="False" />
                        <TextBlock x:Name="ForwardGainText" Margin="0,2,0,8" Text="1.20" />

                        <TextBlock Text="Turn Gain" />
                        <Slider x:Name="TurnGainSlider" Minimum="0.1" Maximum="3.0" Value="1.4" TickFrequency="0.1" IsSnapToTickEnabled="False" />
                        <TextBlock x:Name="TurnGainText" Margin="0,2,0,8" Text="1.40" />

                        <TextBlock Text="Smoothing" />
                        <Slider x:Name="DriveSmoothingSlider" Minimum="0.0" Maximum="0.98" Value="0.86" TickFrequency="0.01" IsSnapToTickEnabled="False" />
                        <TextBlock x:Name="DriveSmoothingText" Margin="0,2,0,8" Text="0.86" />

                        <TextBlock Text="Orienting Stimulus Intensity" />
                        <Slider x:Name="EscapeAggressivenessSlider"
                                Minimum="0.50"
                                Maximum="2.50"
                                Value="1.00"
                                TickFrequency="0.05"
                                IsSnapToTickEnabled="False" />
                        <TextBlock x:Name="EscapeAggressivenessText" Margin="0,2,0,8" Text="1.00x" />

                        <TextBlock Text="Orienting Stimulus Cooldown (ms)" />
                        <Slider x:Name="EscapeCooldownSlider"
                                Minimum="250"
                                Maximum="3000"
                                Value="900"
                                TickFrequency="50"
                                IsSnapToTickEnabled="False" />
                        <TextBlock x:Name="EscapeCooldownText" Margin="0,2,0,8" Text="900 ms" />

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Margin="8,0,8,8" BorderBrush="#1A2F5D" BorderThickness="1" CornerRadius="4" Background="#061633">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Margin="8,6,8,4" Text="Maze Log" FontWeight="SemiBold" />
                <TextBox Grid.Row="1"
                         x:Name="LogTextBox"
                         Margin="8,0,8,8"
                         Background="#030E24"
                         Foreground="#D8E6FF"
                         FontFamily="Consolas"
                         FontSize="12"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap" />
            </Grid>
        </Border>
    </Grid>
</Window>

