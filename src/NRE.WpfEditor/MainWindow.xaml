                                             Background="#0E1830"
                                             Foreground="#D3E0FF" />
                                </Border>
                            </layout:LayoutAnchorable>
                            <layout:LayoutAnchorable x:Name="OutputAnchorable" Title="Output" CanClose="False" CanHide="True">
                                <Border Background="#111A2E" Padding="8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock x:Name="RenderStatusText"
                                                   Grid.Row="0"
                                                   Margin="0,0,0,6"
                                                   Foreground="#9EB3E5"
