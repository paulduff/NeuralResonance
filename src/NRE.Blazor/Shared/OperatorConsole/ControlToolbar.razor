@using Microsoft.AspNetCore.Components.Forms

<div class="toolbar">
    <button class="btn btn-action" @onclick="OnStart" @attributes="(IsRunning ? DisabledAttributes : null)">▶ Start</button>
    <button class="btn btn-warning" @onclick="OnStop" @attributes="(!IsRunning ? DisabledAttributes : null)">■ Stop</button>
    <span class="toolbar-divider"></span>
    <button class="btn btn-sm" @onclick="OnSave" title="Save brain state to file">💾 Save</button>
    <button class="btn btn-sm" @onclick="OnLoad" title="Load brain state from file">📂 Load</button>
    <span class="toolbar-divider"></span>
    <button class="btn btn-sm" @onclick="OnToggleDark">@(IsDark ? "☀" : "🌙")</button>
    <button class="btn btn-sm" @onclick="OnToggleAvatar" title="Toggle Body Avatar">🧍</button>
    <InputFile id="brainFileInput" OnChange="OnBrainFileSelected" style="display:none" accept=".nre" />
</div>

@code {
    [Parameter] public bool IsRunning { get; set; }
    [Parameter] public bool IsDark { get; set; }
    [Parameter] public IReadOnlyDictionary<string, object>? DisabledAttributes { get; set; }
    [Parameter] public EventCallback OnStart { get; set; }
    [Parameter] public EventCallback OnStop { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnLoad { get; set; }
    [Parameter] public EventCallback OnToggleDark { get; set; }
    [Parameter] public EventCallback OnToggleAvatar { get; set; }
    [Parameter] public EventCallback<InputFileChangeEventArgs> OnBrainFileSelected { get; set; }
}
