{
  "schemaVersion": 1,
  "name": "DNNE distributed deployables",
  "description": "Package groups for running the control program, WPF simulators, and brain structure services across separate machines.",
  "controlBaseUrlDefault": "http://localhost:5080",
  "listenHostDefault": "127.0.0.1",
  "apps": {
    "control-program": {
      "project": "ControlProgram/NeuralResonanceEngine.ControlProgram.csproj",
      "role": "control",
      "platforms": [ "windows", "linux" ]
    },
    "world-sim": {
      "project": "src/NRE.WpfWorldSim/NRE.WpfWorldSim.csproj",
      "role": "wpf",
      "platforms": [ "windows" ]
    },
    "editor": {
      "project": "src/NRE.WpfEditor/NRE.WpfEditor.csproj",
      "role": "wpf",
      "platforms": [ "windows" ]
    },
    "maze-sim": {
      "project": "src/NRE.WpfMazeSim/NRE.WpfMazeSim.csproj",
      "role": "wpf",
      "platforms": [ "windows" ]
    }
  },
  "deployables": [
    {
      "name": "machine1-control-avatar",
      "description": "Control Program plus the authoritative WPF world and optional editor. Keep this on the interactive Windows machine.",
      "required": true,
      "platforms": [ "windows" ],
      "apps": [ "control-program", "world-sim", "editor" ],
      "structures": []
    },
    {
      "name": "machine1-maze-diagnostic",
      "description": "Optional WPF maze diagnostic. This is not part of the authoritative WorldSim embodiment path.",
      "required": false,
      "platforms": [ "windows" ],
      "apps": [ "maze-sim" ],
      "structures": []
    },
    {
      "name": "visual-perception",
      "description": "Retinal input, early visual cortex, visual feature/motion streams, and attentional orienting.",
      "required": true,
      "platforms": [ "windows", "linux" ],
      "apps": [],
      "structures": [ "Retina", "LateralGeniculateNucleus", "V1", "V2", "V3", "V4", "Mt", "TemporalAssociation", "Pulvinar", "SuperiorColliculus" ]
    },
    {
      "name": "auditory",
      "description": "Cochlear and midbrain auditory pathway through primary auditory cortex.",
      "required": true,
      "platforms": [ "windows", "linux" ],
      "apps": [],
      "structures": [ "Cochlea", "CochlearNucleus", "SuperiorOlive", "InferiorColliculus", "MedialGeniculateNucleus", "A1", "AuditoryAssociationCortex" ]
    },
    {
      "name": "body-motor-cerebellum",
      "description": "Somatosensory, vestibular, motor cortex, spinal, brainstem, and cerebellar timing/correction circuits.",
      "required": true,
      "platforms": [ "windows", "linux" ],
      "apps": [],
      "structures": [
        "S1",
        "SecondarySomatosensoryCortex",
        "SomaticAfferents",
        "ProprioceptiveAfferents",
        "VestibularAfferents",
        "VisceralAfferents",
        "VestibularNuclei",
        "NucleusTractusSolitarius",
        "VentralPosterolateralThalamus",
        "VentralPosteromedialThalamus",
        "M1",
        "PremotorCortex",
        "Sma",
        "MotorThalamus",
        "SpinalCordMotor",
        "ReticularFormation",
        "PontineNuclei",
        "RedNucleus",
        "PedunculopontineNucleus",
        "LaterodorsalTegmentalNucleus",
        "ParabrachialComplex",
        "PrincipalSensoryTrigeminalNucleus",
        "SpinalTrigeminalNucleus",
        "MesencephalicTrigeminalNucleus",
        "FacialMotorNucleus",
        "OculomotorNucleus",
        "HypoglossalNucleus",
        "CerebellarGranule",
        "CerebellarVermis",
        "CerebellarLobules",
        "PurkinjeCellLayer",
        "DentateNucleus",
        "InterposedNuclei",
        "FastigialNucleus",
        "InferiorOlive"
      ]
    },
    {
      "name": "memory-navigation",
      "description": "Medial temporal memory, contextual scene, and navigation circuits.",
      "required": true,
      "platforms": [ "windows", "linux" ],
      "apps": [],
      "structures": [
        "EntorhinalCortex",
        "DentateGyrus",
        "CA3",
        "CA2",
        "CA1",
        "Subiculum",
        "Presubiculum",
        "Parasubiculum",
        "ParahippocampalCortex",
        "PerirhinalCortex",
        "PosteriorCingulate",
        "RetrosplenialCortex",
        "AnteriorThalamicNuclei",
        "NucleusReuniens",
        "MedialSeptalNucleus",
        "DiagonalBandNucleus"
      ]
    },
    {
      "name": "attention-language-executive",
      "description": "Prefrontal, thalamic, parietal, interhemispheric, language, and cortical association loops.",
      "required": true,
      "platforms": [ "windows", "linux" ],
      "apps": [],
      "structures": [
        "Pfc",
        "DorsomedialPrefrontalCortex",
        "VentromedialPrefrontalCortex",
        "FrontalEyeFields",
        "Ppc",
        "Precuneus",
        "TemporoparietalJunction",
        "Trn",
        "MediodorsalThalamus",
        "IntralaminarThalamus",
        "CorpusCallosum",
        "BrocaBa44Ba45",
        "WernickePstgPsts",
        "ArcuateFasciculus",
        "SupramarginalAngular",
        "FusiformGyrus",
        "InferotemporalCortex",
        "TemporalPole",
        "MidcingulateCortex",
        "OrbitofrontalCortex",
        "Insula"
      ]
    },
    {
      "name": "limbic-basal-homeostasis",
      "description": "Affect, motivation, basal ganglia action gating, homeostasis, and neuromodulatory circuits.",
      "required": true,
      "platforms": [ "windows", "linux" ],
      "apps": [],
      "structures": [
        "VentrolateralPreopticNucleus",
        "SuprachiasmaticNucleus",
        "ParaventricularHypothalamicNucleus",
        "SupraopticNucleus",
