                                                    Click="ApplyAutoProfileButton_OnClick"
                                                    Content="Apply Auto Profile Tuning" />
                                            <TextBlock x:Name="AutoProfileStatusText"
                                                       Margin="0,6,0,0"
                                                       Foreground="#9EB3E5"
                                                       Text="Auto profile: awaiting runtime settings" />
                                        </StackPanel>
                                    </Expander>
                                    <TextBlock Margin="0,12,0,4" Text="Input Gates" Foreground="#B9C8ED" />
                                    <CheckBox x:Name="AvatarVisionInputGateCheckBox"
                                              Foreground="#C5D2F2"
                                              IsChecked="True"
                                              Checked="InputGatesCheckBox_OnChanged"
                                              Unchecked="InputGatesCheckBox_OnChanged"
                                              Content="Enable Avatar Vision Input" />
                                    <CheckBox x:Name="SpontaneousSpikingInputGateCheckBox"
                                              Margin="0,6,0,0"
                                              Foreground="#C5D2F2"
                                              IsChecked="True"
                                              Checked="InputGatesCheckBox_OnChanged"
                                              Unchecked="InputGatesCheckBox_OnChanged"
                                              Content="Enable Spontaneous Spiking" />
                                    <TextBlock x:Name="InputGatesStatusText"
                                               Margin="0,6,0,0"
                                               Foreground="#9EB3E5"
                                               Text="Input gates: awaiting runtime settings" />
                                    <TextBlock Margin="0,12,0,4" Text="Language Input" Foreground="#B9C8ED" />
                                    <TextBox x:Name="LanguageInputTextBox"
                                             Background="#14203B"
                                             Foreground="#DDE6FF"
                                             BorderBrush="#2D3D63"
                                             Text="repeat hello world" />
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"
                                                   Foreground="#C5D2F2"
                                                   Text="Mode" />
                                        <ComboBox x:Name="LanguageModeCombo"
                                                  Grid.Column="1"
                                                  Margin="0,0,8,0"
                                                  SelectedIndex="0"
                                                  Foreground="#0E1830"
                                                  Background="#E7EEFF">
                                            <ComboBox.ItemContainerStyle>
                                                <Style TargetType="ComboBoxItem">
                                                    <Setter Property="Foreground" Value="#0E1830" />
                                                    <Setter Property="Background" Value="#E7EEFF" />
                                                </Style>
                                            </ComboBox.ItemContainerStyle>
                                            <ComboBoxItem Content="English" Tag="english" />
                                            <ComboBoxItem Content="Comprehension" Tag="comprehension" />
                                            <ComboBoxItem Content="Production" Tag="production" />
                                            <ComboBoxItem Content="Repetition" Tag="repetition" />
                                            <ComboBoxItem Content="Prosody" Tag="prosody" />
                                            <ComboBoxItem Content="Emergent" Tag="emergent" />
                                        </ComboBox>
                                        <TextBlock Grid.Column="2"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"
                                                   Foreground="#C5D2F2"
                                                   Text="Hemisphere" />
                                        <ComboBox x:Name="LanguageHemisphereCombo"
                                                  Grid.Column="3"
                                                  SelectedIndex="0"
                                                  Foreground="#0E1830"
                                                  Background="#E7EEFF">
                                            <ComboBox.ItemContainerStyle>
                                                <Style TargetType="ComboBoxItem">
                                                    <Setter Property="Foreground" Value="#0E1830" />
                                                    <Setter Property="Background" Value="#E7EEFF" />
                                                </Style>
                                            </ComboBox.ItemContainerStyle>
                                            <ComboBoxItem Content="Left" Tag="L" />
                                            <ComboBoxItem Content="Both" Tag="*" />
                                            <ComboBoxItem Content="Right" Tag="R" />
                                        </ComboBox>
                                    </Grid>
                                    <Button x:Name="SendLanguageInputButton"
                                            Margin="0,8,0,0"
                                            Padding="10,4"
                                            Click="SendLanguageInputButton_OnClick"
                                            Content="Send Language Stimulus" />
                                    <TextBlock x:Name="LanguageInputStatusText"
                                               Margin="0,6,0,0"
                                               Foreground="#9EB3E5"
                                               Text="Language: idle" />
                                    <TextBlock Margin="0,12,0,4" Text="Brain Telemetry" Foreground="#B9C8ED" />
                                    <Border Background="#0E1830"
                                            BorderBrush="#2D3D63"
                                            BorderThickness="1"
                                            Padding="6">
                                        <TextBox x:Name="LanguageCommandTelemetryTextBox"
                                                 Height="180"
                                                 BorderThickness="0"
                                                 Background="#0E1830"
                                                 Foreground="#D3E0FF"
                                                 FontFamily="Consolas"
                                                 FontSize="12"
                                                 IsReadOnly="True"
                                                 IsReadOnlyCaretVisible="True"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Disabled"
                                                 Text="Brain telemetry: awaiting runtime state" />
                                    </Border>
                                    <TextBlock Margin="0,12,0,4" Text="Speech Output" Foreground="#B9C8ED" />
                                    <Button x:Name="ToggleSpeechOutputButton"
                                            Margin="0,8,0,0"
                                            Padding="10,4"
                                            Click="ToggleSpeechOutputButton_OnClick"
                                            Content="Disable Speech Output" />
                                    <TextBlock Margin="0,8,0,4" Text="Trigger Mode" Foreground="#B9C8ED" />
                                    <ComboBox x:Name="SpeechTriggerModeCombo"
                                              SelectedIndex="0"
                                              SelectionChanged="SpeechTriggerModeCombo_OnSelectionChanged"
                                              Foreground="#0E1830"
                                              Background="#E7EEFF">
                                        <ComboBox.ItemContainerStyle>
                                            <Style TargetType="ComboBoxItem">
                                                <Setter Property="Foreground" Value="#0E1830" />
                                                <Setter Property="Background" Value="#E7EEFF" />
                                            </Style>
                                        </ComboBox.ItemContainerStyle>
                                        <ComboBoxItem Content="Language Pathway" Tag="language" />
                                        <ComboBoxItem Content="Global Dispatch" Tag="global" />
                                    </ComboBox>
                                    <TextBlock Margin="0,8,0,4" Text="Min Dispatch Spikes" Foreground="#B9C8ED" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="SpeechThresholdSlider"
                                                Grid.Column="0"
                                                Minimum="4"
                                                Maximum="96"
                                                TickFrequency="1"
                                                IsSnapToTickEnabled="True"
                                                ValueChanged="SpeechThresholdSlider_OnValueChanged"
                                                Value="12" />
                                        <TextBlock x:Name="SpeechThresholdText"
                                                   Grid.Column="1"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="#C5D2F2"
                                                   Text="12" />
                                    </Grid>
                                    <TextBlock Margin="0,8,0,4" Text="Speech Rate" Foreground="#B9C8ED" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="SpeechRateSlider"
                                                Grid.Column="0"
                                                Minimum="50"
                                                Maximum="200"
                                                TickFrequency="5"
                                                IsSnapToTickEnabled="True"
                                                ValueChanged="SpeechRateSlider_OnValueChanged"
                                                Value="100" />
                                        <TextBlock x:Name="SpeechRateText"
                                                   Grid.Column="1"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="#C5D2F2"
                                                   Text="1.00x" />
                                    </Grid>
                                    <TextBlock Margin="0,8,0,4" Text="Speech Volume" Foreground="#B9C8ED" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="SpeechVolumeSlider"
                                                Grid.Column="0"
                                                Minimum="0"
                                                Maximum="100"
                                                TickFrequency="1"
                                                IsSnapToTickEnabled="True"
                                                ValueChanged="SpeechVolumeSlider_OnValueChanged"
                                                Value="95" />
                                        <TextBlock x:Name="SpeechVolumeText"
                                                   Grid.Column="1"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="#C5D2F2"
                                                   Text="95%" />
                                    </Grid>
                                    <TextBlock x:Name="SpeechOutputStatusText"
                                               Margin="0,6,0,0"
                                               Foreground="#9EB3E5"
                                               Text="Speech: listening for language pathway activity" />
                                </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </layout:LayoutAnchorable>

                        <layout:LayoutAnchorable x:Name="InspectorAnchorable" Title="Inspector" CanClose="False" CanHide="True">
                            <Border Background="#111A2E" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="Selection Details" Foreground="#DDE6FF" FontWeight="SemiBold" />
                                    <TextBlock x:Name="SelectionNameText" Margin="0,10,0,0" Foreground="#B9C8ED" />
                                    <TextBlock x:Name="SelectionModelText" Margin="0,6,0,0" Foreground="#B9C8ED" />
                                    <TextBlock x:Name="SelectionPlasticityText" Margin="0,6,0,0" Foreground="#B9C8ED" TextWrapping="Wrap" />
                                    <TextBlock x:Name="SelectionMicrotubuleText" Margin="0,6,0,0" Foreground="#D5B8FF" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </layout:LayoutAnchorable>
                    </layout:LayoutAnchorablePane>
                </layout:LayoutPanel>
                </layout:LayoutRoot>
            </dock:DockingManager.Layout>
        </dock:DockingManager>
    </DockPanel>
</Window>

