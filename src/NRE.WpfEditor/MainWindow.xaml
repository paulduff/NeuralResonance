                                                           Foreground="#E6EEFF"
                                                           FontSize="11"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                        </Canvas>
                                    </Grid>
                                </layout:LayoutDocument>
                            </layout:LayoutDocumentPane>
